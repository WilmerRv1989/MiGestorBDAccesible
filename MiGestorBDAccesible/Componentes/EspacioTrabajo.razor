    private static string DescribirEntrada(EntradaHistorialModelo entrada)
    {
        var fecha = entrada.Fecha.Date == DateTime.Today ? $"hoy {entrada.Fecha:HH:mm}"
            : entrada.Fecha.Date == DateTime.Today.AddDays(-1) ? $"ayer {entrada.Fecha:HH:mm}"
            : entrada.Fecha.ToString("dd/MM HH:mm");

        var primeraLinea = entrada.Texto.Split('\n').Select(l => l.Trim())
            .FirstOrDefault(l => l.Length > 0 && !l.StartsWith("--") && !l.StartsWith("USE ", StringComparison.OrdinalIgnoreCase) && !l.Equals("GO", StringComparison.OrdinalIgnoreCase))
            ?? entrada.Texto.Trim();

        if (primeraLinea.Length > 80)
        {
            primeraLinea = primeraLinea[..80] + "…";
        }

        return $"{fecha}, {entrada.BaseDatos ?? "base predeterminada"}: {primeraLinea}. {entrada.Resumen}";
    }

    private async Task AbrirScriptAsync(ScriptAbiertoModelo script)
    {
        var pestana = PestanaParaContenido(script.BaseDatos, script.Descripcion);
        pestana.Texto = script.Texto;
        pestana.TextoGuardado = script.Texto;
        ProgramarGuardadoSesion();

        if (script.Ejecutar)
        {
            StateHasChanged();
            await EjecutarScriptAsync(pestana, script.Texto, 0, 0, true);
            return;
        }

        _enfocarEditorInicio = true;
        StateHasChanged();
        await Task.Delay(600);

        var lineas = script.Texto.TrimEnd().Split('\n').Length;
        await anunciador.AnunciarAsync($"{script.Descripcion} en el editor, {lineas} líneas, {Posicion(pestana)}.");
    }

    private async Task EjecutarScriptAsync(PestanaModelo pestana, string texto, int inicio, int fin, bool enfocarResultados)
    {
        if (pestana.Ejecutando)
        {
            await anunciador.AnunciarAsync($"{pestana.Nombre} todavía está ejecutando.");
            return;
        }

        pestana.Texto = texto;
        var haySeleccion = fin > inicio;
        var script = haySeleccion ? texto[inicio..fin] : texto;

        if (string.IsNullOrWhiteSpace(script))
        {
            await anunciador.AnunciarAsync("El editor está vacío.");
            return;
        }

        var lineaInicial = haySeleccion ? texto[..inicio].Count(c => c == '\n') + 1 : 1;
        var baseEjecucion = pestana.BaseDatos;
        var cancelacion = new CancellationTokenSource();
        pestana.Sesion ??= Conexion.NuevaSesion();

        pestana.Ejecutando = true;
        pestana.Cancelacion = cancelacion;
        StateHasChanged();
        await anunciador.AnunciarAsync(haySeleccion ? "Ejecutando la selección…" : "Ejecutando…");

        try
        {
            var resultado = await proveedores.Obtener(Conexion.Conexion.Motor)
                .EjecutarAsync(pestana.Sesion, pestana.BaseDatos, script, lineaInicial, cancelacion.Token);
            pestana.Resultado = resultado;

            var cambioBase = resultado.BaseDatosFinal is not null
                && !string.Equals(resultado.BaseDatosFinal, pestana.BaseDatos, StringComparison.OrdinalIgnoreCase);

            if (cambioBase)
            {
                pestana.BaseDatos = resultado.BaseDatosFinal;
            }

            var (mensaje, urgente) = TextoResultado(resultado);
            var avisoTransaccion = (pestana.CambiosPendientes, resultado.CambiosPendientes) switch
            {
                (false, true) => "Quedan cambios sin confirmar: COMMIT los guarda y ROLLBACK los deshace. ",
                (true, false) => "Ya no quedan cambios sin confirmar. ",
                _ => ""
            };
            pestana.CambiosPendientes = resultado.CambiosPendientes;

            await historial.AgregarAsync(new EntradaHistorialModelo
            {
                Fecha = DateTime.Now,
                ConexionId = Conexion.Conexion.Id,
                BaseDatos = baseEjecucion,
                Texto = script,
                Resumen = mensaje
            });
            await GuardarSesionAsync();

            var esActiva = pestana == _pestanas.Activa;

            if (enfocarResultados && esActiva)
            {
                pestana.Ejecutando = false;
                _enfocarResultados = true;
                StateHasChanged();
                await Task.Delay(600);
            }

            var prefijo = (esActiva ? "" : $"{pestana.Nombre} terminó. ")
                + (cambioBase && !enfocarResultados ? $"La consulta ahora usa {resultado.BaseDatosFinal}. " : "")
                + avisoTransaccion;

            if (urgente)
            {
                await anunciador.AnunciarUrgenteAsync(prefijo + mensaje);
            }
            else
            {
                await anunciador.AnunciarAsync(prefijo + mensaje);
            }
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo ejecutar. {ex.Message}");
        }
        finally
        {
            pestana.Ejecutando = false;
            pestana.Cancelacion = null;
            cancelacion.Dispose();
            StateHasChanged();
        }
    }

    private void CancelarEjecucion()
    {
        _pestanas.Activa?.Cancelacion?.Cancel();
    }

    private static (string Mensaje, bool Urgente) TextoResultado(ResultadoEjecucionModelo resultado)
    {
        var tiempo = $"{resultado.Duracion.TotalMilliseconds:N0} milisegundos";
        var errores = resultado.Errores.ToList();

        if (errores.Count > 0)
        {
            var primero = errores[0];
            var linea = primero.Linea is int l ? $", línea {l}" : "";
            var cantidad = errores.Count == 1 ? "1 error" : $"{errores.Count} errores";
            return ($"Ejecutado con {cantidad} en {tiempo}. Primero{linea}: {primero.Texto}", true);
        }

        if (resultado.Cancelado)
        {
            return ($"Ejecución cancelada a los {tiempo}.", false);
        }

        if (resultado.Conjuntos.Count == 1)
        {
            return ($"Terminado en {tiempo}, {TextoFilas(resultado.Conjuntos[0].TotalFilas)}.", false);
        }

        if (resultado.Conjuntos.Count > 1)
        {
            var filas = NarradorTablaService.Unir(resultado.Conjuntos.Select(c => c.TotalFilas.ToString("N0")));
            return ($"Terminado en {tiempo}, {resultado.Conjuntos.Count} resultados, con {filas} filas.", false);
        }

        if (resultado.FilasAfectadas > 0)
        {
            var afectadas = resultado.FilasAfectadas == 1 ? "1 fila afectada" : $"{resultado.FilasAfectadas:N0} filas afectadas";
            return ($"Terminado en {tiempo}, {afectadas}.", false);
        }

        var ultimaSentencia = resultado.Mensajes.LastOrDefault(m => m.Tipo == TipoMensaje.Informacion && m.Numero is null && m.Linea is not null);

        return ultimaSentencia is not null
            ? ($"Terminado en {tiempo}. {ultimaSentencia.Texto}", false)
            : ($"Terminado en {tiempo}. Comandos completados correctamente.", false);
    }

