    private async Task LeerModeloAsync(string baseDatos, bool abrirJoin)
    {
        if (_lecturaModelo is not null)
        {
            await anunciador.AnunciarAsync($"Ya estoy leyendo el modelo de {_baseLeyendo}. Espera a que termine o cancela la lectura.");
            return;
        }

        if (abrirJoin && _modelo?.BaseDatos == baseDatos)
        {
            AbrirCaminoJoin();
            return;
        }

        _lecturaModelo = new CancellationTokenSource();
        _dependencias = null;
        _baseLeyendo = baseDatos;
        _avanceModelo = "Preparando la lectura…";
        _descripcion = null;
        _enfocarCancelarLectura = true;
        StateHasChanged();
        await anunciador.AnunciarAsync($"Leyendo el modelo de {baseDatos}. Escape cancela.");

        var avance = new Progress<AvanceLecturaModelo>(a =>
        {
            _avanceModelo = $"Leídos {a.Leidos} de {a.Total} objetos.";
            StateHasChanged();
        });

        try
        {
            var modelo = await LectorModeloService.LeerAsync(proveedores.Obtener(Conexion.Conexion.Motor), Conexion, baseDatos, avance, _lecturaModelo.Token);
            _modelo = modelo;
            _descripcionModelo = narradorModelo.Describir(modelo, Conexion.Conexion.Motor);
            _tablaModeloEnfocar = null;
            _versionModelo++;
            _lecturaModelo = null;

            if (abrirJoin)
            {
                AbrirCaminoJoin();
            }
        }
        catch (OperationCanceledException)
        {
            _lecturaModelo = null;
            StateHasChanged();
            await anunciador.AnunciarAsync("Lectura del modelo cancelada.");
            await EnfocarExploradorAsync();
        }
        catch (Exception ex)
        {
            _lecturaModelo = null;
            StateHasChanged();
            await anunciador.AnunciarUrgenteAsync($"No se pudo leer el modelo de {baseDatos}. {ex.Message}");
            await EnfocarExploradorAsync();
        }
    }

