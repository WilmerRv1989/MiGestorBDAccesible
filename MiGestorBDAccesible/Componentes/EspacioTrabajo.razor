    private string TituloCaminos()
    {
        var desde = _modelo!.Tablas[_joinDesde].Tabla.NombreCorto();
        var hasta = _modelo.Tablas[_joinHasta].Tabla.NombreCorto();

        if (_joinDesde == _joinHasta)
        {
            return "Elegiste la misma tabla en Desde y en Hasta: no hace falta ningún JOIN.";
        }

        return _caminos!.Count switch
        {
            0 => $"No hay ningún camino de llaves foráneas entre {desde} y {hasta}.",
            1 => $"Camino de {desde} a {hasta}",
            var n => $"{n} caminos igual de cortos de {desde} a {hasta}"
        };
    }

    private void BuscarCaminoAsync()
    {
        _caminos = AnalizadorModeloService.CaminosJoin(_modelo!, _modelo!.Tablas[_joinDesde].Tabla, _modelo.Tablas[_joinHasta].Tabla);
        _enfocarCaminos = true;
    }

    private async Task AbrirCaminoAsync(int indice)
    {
        var desde = _modelo!.Tablas[_joinDesde].Tabla;
        var hasta = _modelo.Tablas[_joinHasta].Tabla;
        var sql = AnalizadorModeloService.ConsultaJoin(proveedores.Obtener(Conexion.Conexion.Motor).Dialecto, desde, _caminos![indice]);
        var baseDatos = _modelo.BaseDatos;

        _joinAbierto = false;
        _caminos = null;
        await AbrirScriptAsync(new ScriptAbiertoModelo(baseDatos, sql, false, $"JOIN de {desde.NombreCorto()} a {hasta.NombreCorto()}"));
    }

    private async Task GuardarModeloAsync()
    {
        var ruta = archivos.ElegirParaGuardar("Guardar la descripción del modelo", ArchivosService.FiltroHtml, $"Modelo de {_modelo!.BaseDatos}.html", "html");

        if (ruta is null)
        {
            return;
        }

        try
        {
            await archivos.GuardarAsync(ruta, NarradorModeloService.Html(_descripcionModelo!));
            await anunciador.AnunciarAsync($"Modelo guardado en {Path.GetFileName(ruta)}.");
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo guardar el archivo. {ex.Message}");
        }
    }

    private async Task VerDependenciasAsync(NodoArbolModelo nodo)
    {
        var objetivo = nodo.Objeto is { } objeto ? DependenciasService.DesdeObjeto(objeto) : DependenciasService.DesdeTabla(nodo.Tabla!);

        try
        {
            var dependencias = await DependenciasService.LeerAsync(proveedores.Obtener(Conexion.Conexion.Motor), Conexion, nodo.BaseDatos!, objetivo);
            _baseDependencias = nodo.BaseDatos;
            _nombreDependencias = objetivo.Tabla is { } tabla && objetivo.Tipo == TipoResultadoBusqueda.Disparador
                ? $"{objetivo.Nombre}, de la tabla {tabla.NombreCompleto}"
                : objetivo.NombreCompleto;
            _quienUsa = objetivo.Tipo is TipoResultadoBusqueda.Tabla or TipoResultadoBusqueda.Vista or TipoResultadoBusqueda.Funcion ? "Quién la usa" : "Quién lo usa";
            _dependencias = dependencias;
            _descripcion = null;
            _versionDependencias++;
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudieron leer las dependencias de {nodo.Texto}. {ex.Message}");
        }
    }

    private async Task IrADependenciaAsync(ResultadoBusquedaObjetoModelo objeto)
    {
        if (_explorador is not null && _baseDependencias is not null)
        {
            await _explorador.UbicarAsync(_baseDependencias, objeto);
        }
    }

    private async Task DescribirAsync(NodoArbolModelo nodo)
    {
        _dependencias = null;

        try
        {
            var proveedor = proveedores.Obtener(Conexion.Conexion.Motor);

            if (nodo.Objeto is { } objeto)
            {
                var detalleObjeto = await proveedor.ObtenerDetalleObjetoAsync(Conexion, nodo.BaseDatos!, objeto);
                _descripcion = narradorObjetos.Describir(detalleObjeto, Conexion.Conexion.Motor);
                _temasDescripcion = string.Join("|", objeto.Tipo.TemasAyuda());
                return;
            }

            var detalle = await proveedor.ObtenerDetalleTablaAsync(Conexion, nodo.BaseDatos!, nodo.Tabla!);
            _descripcion = narrador.Describir(detalle, proveedor.Capacidades.Terminos);
            _temasDescripcion = "concepto:tabla|concepto:clave-principal|concepto:llave-foranea|concepto:uno-a-muchos|concepto:muchos-a-muchos|concepto:indice";
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo describir {nodo.Texto}. {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var pestana in _pestanas.Pestanas)
        {
            pestana.Cancelacion?.Cancel();
        }

        _guardadoSesion?.Cancel();
        await GuardarSesionAsync();

        try
        {
            await js.InvokeVoidAsync("miGestor.registrarEspacio", null);
        }
        catch (JSDisconnectedException)
        {
        }

        _referencia?.Dispose();
    }
}
