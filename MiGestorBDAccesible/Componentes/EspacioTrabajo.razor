@using MiGestorBDAccesible.Core.Ejecucion
@using MiGestorBDAccesible.Core.Trabajo
@using System.IO
@implements IAsyncDisposable
@inject ProveedoresService proveedores
@inject NarradorTablaService narrador
@inject NarradorObjetoService narradorObjetos
@inject NarradorModeloService narradorModelo
@inject AnunciadorService anunciador
@inject ArchivosService archivos
@inject HistorialConsultasService historial
@inject SesionEditorService sesiones
@inject IJSRuntime js

<div class="espacio" inert="@(_historialAbierto || _preguntarDesconexion || _pestanaPorCerrar is not null || _joinAbierto)">
    <header class="cabecera">
        <h1>@Conexion.Conexion.Nombre</h1>
        <p class="detalle">@Conexion.Servidor.Producto, @Conexion.Servidor.Edicion, versión @Conexion.Servidor.Version.</p>
        @if (Conexion.Servidor.Advertencia is not null)
        {
            <p class="aviso-transaccion">@Conexion.Servidor.Advertencia</p>
        }
        <button id="boton-desconectar" @onclick="DesconectarAsync">Desconectar</button>
    </header>

    <nav class="zona-explorador" aria-label="Explorador de objetos">
        <Explorador @ref="_explorador"
                    Conexion="Conexion"
                    AlDescribir="DescribirAsync"
                    AlNuevaTabla="AbrirNuevaTabla"
                    AlNuevaConsulta="NuevaConsulta"
                    AlAbrirScript="AbrirScriptAsync"
                    AlEditarFilas="AbrirEditorFilasAsync"
                    AlDescribirModelo="(b) => LeerModeloAsync(b, false)"
                    AlCaminoJoin="(b) => LeerModeloAsync(b, true)"
                    AlVerDependencias="VerDependenciasAsync" />
    </nav>

    <div class="zona-detalle">
        @if (_filasTabla is not null)
        {
            <EditorFilas @key="@($"filas{_versionFilas}")" @ref="_editorFilas"
                         Conexion="Conexion"
                         BaseDatos="@(_filasBase ?? string.Empty)"
                         Tabla="_filasTabla"
                         AlCerrar="CerrarEditorFilasAsync" />
        }

        @if (_baseNuevaTabla is not null)
        {
            <FormularioTabla @key="@($"tabla{_versionFormulario}")"
                             Conexion="Conexion"
                             BaseDatos="@_baseNuevaTabla"
                             DefinicionInicial="_definicionInicial"
                             Original="_originalTabla"
                             AlModificar="TablaModificadaAsync"
                             AlAbrirScript="AbrirScriptAsync"
                             MensajeInicial="@_mensajeInicial"
                             AlCrear="TablaCreadaAsync"
                             AlCancelar="CancelarNuevaTablaAsync" />
        }

        @if (_pestanas.Activa is { } activa)
        {
            <section class="consulta" aria-labelledby="titulo-consulta" data-base="@activa.BaseDatos">
                <div role="tablist" aria-label="Pestañas de consulta" class="pestanas" data-zona="pestanas" @onkeydown="TeclaPestanasAsync">
                    @foreach (var pestana in _pestanas.Pestanas)
                    {
                        <button role="tab" id="@($"pestana-{pestana.Id}")"
                                aria-selected="@(pestana == activa ? "true" : "false")"
                                aria-controls="panel-consulta"
                                tabindex="@(pestana == activa ? 0 : -1)"
                                @onclick="() => ActivarPestanaAsync(pestana, true)">@pestana.Etiqueta</button>
                    }
                </div>
                <div role="tabpanel" id="panel-consulta" aria-labelledby="@($"pestana-{activa.Id}")">
                    <EditorConsulta @key="activa.Id" @ref="_editorConsulta"
                                    Busqueda="_busqueda"
                                    BaseDatos="@activa.BaseDatos"
                                    Archivo="@(activa.Archivo is null ? null : activa.Nombre)"
                                    Modificado="activa.Modificado"
                                    Texto="@activa.Texto"
                                    TextoChanged="CambiarTexto"
                                    Ejecutando="activa.Ejecutando"
                                    AlCancelar="CancelarEjecucion" />
                    @if (activa.CambiosPendientes)
                    {
                        <p class="aviso-transaccion">Hay cambios sin confirmar en esta pestaña. COMMIT los guarda en la base de datos y ROLLBACK los deshace.</p>
                    }
                    <PanelResultados @key="@($"r{activa.Id}")" Resultado="activa.Resultado" />
                    <PanelMensajes @key="@($"m{activa.Id}")" Resultado="activa.Resultado" />
                </div>
            </section>
        }

        <section class="descripcion" aria-labelledby="titulo-detalle"
                 data-ayuda="@(_descripcion is not null ? _temasDescripcion : _descripcionModelo is not null ? "concepto:llave-foranea|concepto:uno-a-muchos|concepto:muchos-a-muchos|concepto:indice" : null)">
            @if (_lecturaModelo is not null)
            {
                <h2 id="titulo-detalle">Leyendo el modelo de @_baseLeyendo</h2>
                <p>@_avanceModelo</p>
                <button id="cancelar-lectura" @onclick="CancelarLecturaModelo" @onkeydown="TeclaLecturaModelo">Cancelar la lectura</button>
            }
            else if (_dependencias is not null)
            {
                <DescripcionDependencias @key="_versionDependencias"
                                         Nombre="@_nombreDependencias"
                                         Dependencias="_dependencias"
                                         QuienUsa="@_quienUsa"
                                         DisparadoresBase="@proveedores.Obtener(Conexion.Conexion.Motor).Capacidades.TituloDisparadoresBase.Replace("Disparadores ", "")"
                                         AlIr="IrADependenciaAsync" />
            }
            else if (_descripcion is not null)
            {
                <DescripcionTabla Descripcion="_descripcion" />
                @if (_descripcionModelo is not null)
                {
                    <button class="enlace" @onclick="VolverAlModeloAsync">Volver al modelo de @_modelo!.BaseDatos</button>
                }
            }
            else if (_descripcionModelo is not null)
            {
                <DescripcionModelo @key="_versionModelo"
                                   Descripcion="_descripcionModelo"
                                   EnfocarTabla="_tablaModeloEnfocar"
                                   AlDescribirTabla="DescribirTablaModelo"
                                   AlCaminoJoin="AbrirCaminoJoin"
                                   AlGuardar="GuardarModeloAsync" />
            }
            else
            {
                <h2 id="titulo-detalle">Detalle</h2>
                <p>Elige una tabla en el explorador y pulsa Intro para describirla.</p>
                @if (_pestanas.Activa is null)
                {
                    <p>Para escribir SQL, ponte sobre una base de datos y pulsa Control+N o Control+T: se abre una consulta conectada a esa base. Control+O abre un archivo .sql.</p>
                }
            }
        </section>
    </div>
</div>

@if (_historialAbierto)
{
    <DialogoAccion Titulo="Historial de consultas" AlCancelar="CerrarHistorial">
        @if (_entradasHistorial is null)
        {
            <p>Cargando el historial…</p>
        }
        else if (_entradasHistorial.Count == 0)
        {
            <p>Todavía no hay consultas en el historial de esta conexión.</p>
        }
        else
        {
            <p>@(_entradasHistorial.Count == 1 ? "1 consulta" : $"{_entradasHistorial.Count} consultas"), de la más reciente a la más antigua. Activa una para ponerla en el editor.</p>
            <ul class="lista-temas lista-historial">
                @for (var i = 0; i < _entradasHistorial.Count; i++)
                {
                    var entrada = _entradasHistorial[i];
                    <li>
                        <button id="@($"historial-{i}")" class="enlace" @onclick="() => UsarEntradaAsync(entrada)">@DescribirEntrada(entrada)</button>
                    </li>
                }
            </ul>
        }
        <div class="acciones">
            @if (_entradasHistorial is { Count: > 0 })
            {
                <button class="peligro" @onclick="BorrarHistorialAsync">Borrar el historial</button>
            }
            <button @onclick="CerrarHistorial">Cerrar</button>
        </div>
    </DialogoAccion>
}

@if (_preguntarDesconexion)
{
    <DialogoAccion Titulo="Hay cambios sin confirmar" EsAlerta="true" AlCancelar="SeguirConectado">
        <p>Hiciste cambios con INSERT, UPDATE, DELETE o MERGE que todavía no se guardaron en la base de datos@(PestanasConPendientes().Select(p => p.Nombre).Concat(_editorFilas?.CambiosPendientes > 0 ? ["el panel de edición de filas"] : []).ToList() is { Count: > 0 } conPendientes ? $", en {NarradorTablaService.Unir(conPendientes)}" : ""). ¿Qué hago con ellos antes de desconectar?</p>
        <div class="acciones">
            <button class="principal" @onclick="() => TerminarDesconexionAsync(true)">Confirmar los cambios (COMMIT)</button>
            <button class="peligro" @onclick="() => TerminarDesconexionAsync(false)">Deshacer los cambios (ROLLBACK)</button>
            <button data-foco-inicial @onclick="SeguirConectado">Seguir conectado</button>
        </div>
    </DialogoAccion>
}

@if (_joinAbierto && _modelo is not null)
{
    <DialogoAccion Titulo="@($"Camino de JOIN en {_modelo.BaseDatos}")" AlCancelar="CerrarCaminoJoin">
        @if (_modelo.Tablas.Count < 2)
        {
            <p>Hacen falta al menos dos tablas para buscar un camino.</p>
        }
        else
        {
            <p>Elige dos tablas: busco el camino más corto entre ellas siguiendo las llaves foráneas.</p>
            <div class="campo">
                <label for="join-desde">Desde</label>
                <select id="join-desde" data-foco-inicial @bind="_joinDesde">
                    @for (var i = 0; i < _modelo.Tablas.Count; i++)
                    {
                        <option value="@i">@_modelo.Tablas[i].Tabla.NombreCorto()</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="join-hasta">Hasta</label>
                <select id="join-hasta" @bind="_joinHasta">
                    @for (var i = 0; i < _modelo.Tablas.Count; i++)
                    {
                        <option value="@i">@_modelo.Tablas[i].Tabla.NombreCorto()</option>
                    }
                </select>
            </div>
            @if (_caminos is not null)
            {
                <h3 id="titulo-caminos" tabindex="-1">@TituloCaminos()</h3>
                @if (_caminos.Count > 0)
                {
                    <ul class="frases">
                        @for (var i = 0; i < _caminos.Count; i++)
                        {
                            var indice = i;
                            <li>
                                <p>@(_caminos.Count > 1 ? $"Camino {indice + 1}: " : "")@NarradorModeloService.DescribirCamino(_caminos[indice])</p>
                                <button @onclick="() => AbrirCaminoAsync(indice)">@(_caminos.Count > 1 ? $"Abrir el camino {indice + 1} en una pestaña nueva" : "Abrir en una pestaña nueva")</button>
                            </li>
                        }
                    </ul>
                }
            }
        }
        <div class="acciones">
            @if (_modelo.Tablas.Count >= 2)
            {
                <button class="principal" @onclick="BuscarCaminoAsync">Buscar el camino</button>
            }
            <button @onclick="CerrarCaminoJoin">Cerrar</button>
        </div>
    </DialogoAccion>
}

@if (_pestanaPorCerrar is not null)
{
    <DialogoAccion Titulo="@($"{_pestanaPorCerrar.Nombre} tiene cambios sin confirmar")" EsAlerta="true" AlCancelar="NoCerrarPestana">
        <p>En esta pestaña hiciste cambios que todavía no se guardaron en la base de datos. ¿Qué hago con ellos antes de cerrarla?</p>
        <div class="acciones">
            <button class="principal" @onclick="() => TerminarCierreAsync(true)">Confirmar los cambios (COMMIT)</button>
            <button class="peligro" @onclick="() => TerminarCierreAsync(false)">Deshacer los cambios (ROLLBACK)</button>
            <button data-foco-inicial @onclick="NoCerrarPestana">No cerrar la pestaña</button>
        </div>
    </DialogoAccion>
}

@code {
    [Parameter, EditorRequired] public ConexionActiva Conexion { get; set; } = default!;
    [Parameter] public EventCallback AlDesconectar { get; set; }

    private DotNetObjectReference<EspacioTrabajo>? _referencia;
    private Explorador? _explorador;
    private string? _baseNuevaTabla;
    private MiGestorBDAccesible.Core.Definicion.DefinicionTablaModelo? _definicionInicial;
    private DetalleTablaModelo? _originalTabla;
    private EditorFilas? _editorFilas;
    private string? _filasBase;
    private TablaModelo? _filasTabla;
    private int _versionFilas;
    private string? _mensajeInicial;
    private int _versionFormulario;
    private DescripcionTablaModelo? _descripcion;
    private string _temasDescripcion = "";
    private ConjuntoPestanasModelo _pestanas = new();
    private PestanaModelo? _pestanaPorCerrar;
    private bool _enfocarEditor;
    private bool _enfocarEditorInicio;
    private bool _enfocarResultados;
    private string? _enfocarPestana;
    private string? _avisoSesion;
    private CancellationTokenSource? _guardadoSesion;
    private bool _historialAbierto;
    private List<EntradaHistorialModelo>? _entradasHistorial;
    private bool _preguntarDesconexion;
    private bool _enfocarDesconectar;
    private EditorConsulta? _editorConsulta;
    private DependenciasModelo? _dependencias;
    private string _nombreDependencias = "";
    private string _quienUsa = "Quién lo usa";
    private string? _baseDependencias;
    private int _versionDependencias;
    private readonly BusquedaModelo _busqueda = new();
    private ModeloBaseDatosModelo? _modelo;
    private DescripcionModeloModelo? _descripcionModelo;
    private CancellationTokenSource? _lecturaModelo;
    private string? _baseLeyendo;
    private string _avanceModelo = "";
    private bool _enfocarCancelarLectura;
    private int _versionModelo;
    private int? _tablaModeloEnfocar;
    private bool _joinAbierto;
    private int _joinDesde;
    private int _joinHasta = 1;
    private List<List<PasoJoinModelo>>? _caminos;
    private bool _enfocarCaminos;

    protected override async Task OnInitializedAsync()
    {
        _pestanas = ConjuntoPestanasModelo.Recuperar(await sesiones.ObtenerAsync(Conexion.Conexion.Id));

        if (_pestanas.Activa is { } activa)
        {
            var archivo = activa.Archivo is null ? "" : $", del archivo {activa.Nombre}";
            _avisoSesion = _pestanas.Pestanas.Count == 1
                ? $"Se recuperó tu consulta anterior en {activa.BaseDatos ?? "la base predeterminada"}{archivo}."
                : $"Se recuperaron {_pestanas.Pestanas.Count} pestañas; activa: {activa.Nombre} en {activa.BaseDatos ?? "la base predeterminada"}.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _referencia = DotNetObjectReference.Create(this);
            await js.InvokeVoidAsync("miGestor.registrarEspacio", _referencia);

            if (_avisoSesion is not null)
            {
                await Task.Delay(1500);
                await anunciador.AnunciarAsync(_avisoSesion);
                _avisoSesion = null;
            }
        }

        if (_enfocarEditor)
        {
            _enfocarEditor = false;
            await js.InvokeVoidAsync("miGestor.enfocar", "editor-sql");
        }

        if (_enfocarEditorInicio)
        {
            _enfocarEditorInicio = false;
            await js.InvokeVoidAsync("miGestor.enfocarInicio", "editor-sql");
        }

        if (_enfocarResultados)
        {
            _enfocarResultados = false;
            await js.InvokeVoidAsync("miGestor.enfocar", "titulo-resultados");
        }

        if (_enfocarPestana is not null)
        {
            var id = _enfocarPestana;
            _enfocarPestana = null;
            await js.InvokeVoidAsync("miGestor.enfocar", id);
        }

        if (_enfocarDesconectar)
        {
            _enfocarDesconectar = false;
            await js.InvokeVoidAsync("miGestor.enfocar", "boton-desconectar");
        }

        if (_enfocarCancelarLectura)
        {
            _enfocarCancelarLectura = false;
            await js.InvokeVoidAsync("miGestor.enfocar", "cancelar-lectura");
        }

        if (_enfocarCaminos)
        {
            _enfocarCaminos = false;
            await js.InvokeVoidAsync("miGestor.enfocar", "titulo-caminos");
        }
    }

    private async Task DesconectarAsync()
    {
        var proveedor = proveedores.Obtener(Conexion.Conexion.Motor);

        if (_pestanas.Pestanas.FirstOrDefault(p => p.Ejecutando) is { } ejecutando)
        {
            await anunciador.AnunciarAsync($"{ejecutando.Nombre} está ejecutando. Espera a que termine o cancélala antes de desconectar.");
            return;
        }

        if (proveedor.TieneCambiosPendientes(Conexion) || _editorFilas?.CambiosPendientes > 0)
        {
            _preguntarDesconexion = true;
            return;
        }

        await proveedor.FinalizarSesionAsync(Conexion, false);
        await AlDesconectar.InvokeAsync();
    }

    private void SeguirConectado()
    {
        _preguntarDesconexion = false;
        _enfocarDesconectar = true;
    }

    private async Task TerminarDesconexionAsync(bool confirmar)
    {
        var mensaje = await proveedores.Obtener(Conexion.Conexion.Motor).FinalizarSesionAsync(Conexion, confirmar);

        if (_editorFilas?.CambiosPendientes > 0)
        {
            mensaje = await _editorFilas.TerminarSinAnunciarAsync(confirmar) ?? (confirmar ? "Cambios confirmados (COMMIT)." : "Cambios deshechos (ROLLBACK).");
        }
        _preguntarDesconexion = false;
        await AlDesconectar.InvokeAsync();

        if (mensaje is not null)
        {
            await Task.Delay(600);
            await anunciador.AnunciarAsync($"{mensaje} Desconectado de {Conexion.Conexion.Nombre}.");
        }
    }

    private List<PestanaModelo> PestanasConPendientes()
    {
        var proveedor = proveedores.Obtener(Conexion.Conexion.Motor);
        return _pestanas.Pestanas.Where(p => p.Sesion is not null && proveedor.TieneCambiosPendientes(p.Sesion)).ToList();
    }

    private void CambiarTexto(string texto)
    {
        if (_pestanas.Activa is { } activa)
        {
            activa.Texto = texto;
            ProgramarGuardadoSesion();
        }
    }

    private void ProgramarGuardadoSesion()
    {
        _guardadoSesion?.Cancel();
        _guardadoSesion = new CancellationTokenSource();
        var token = _guardadoSesion.Token;

        _ = Task.Delay(1000, token).ContinueWith(async t =>
        {
            if (!t.IsCanceled)
            {
                await GuardarSesionAsync();
            }
        }, TaskScheduler.Default);
    }

    private Task GuardarSesionAsync() => sesiones.GuardarAsync(_pestanas.Guardar(Conexion.Conexion.Id));

    private string Posicion(PestanaModelo pestana) => $"pestaña {_pestanas.Posicion(pestana)} de {_pestanas.Pestanas.Count}";

    private PestanaModelo AbrirPestana(string? baseDatos, string texto = "", string? archivo = null, string? titulo = null)
    {
        var pestana = _pestanas.Abrir(baseDatos, texto, archivo, titulo);
        pestana.Sesion = Conexion.NuevaSesion();
        return pestana;
    }

    private PestanaModelo PestanaParaContenido(string? baseDatos, string? titulo = null)
    {
        if (_pestanas.Activa is { EstaVacia: true, Ejecutando: false } vacia)
        {
            vacia.BaseDatos = baseDatos ?? vacia.BaseDatos;
            vacia.Titulo = titulo;
            return vacia;
        }

        return AbrirPestana(baseDatos ?? Conexion.Conexion.BaseDatosInicial, titulo: titulo);
    }

    [JSInvokable]
    public Task NuevaConsulta(string? baseDatos)
    {
        return InvokeAsync(async () =>
        {
            var baseNueva = string.IsNullOrWhiteSpace(baseDatos) ? Conexion.Conexion.BaseDatosInicial : baseDatos;
            var activa = _pestanas.Activa;

            if (activa is null)
            {
                AbrirPestana(baseNueva);
                _enfocarEditor = true;
                StateHasChanged();
                await GuardarSesionAsync();
                await anunciador.AnunciarAsync($"Consulta abierta en {baseNueva ?? "la base predeterminada"}.");
                return;
            }

            var baseAnterior = activa.BaseDatos;
            var proveedor = proveedores.Obtener(Conexion.Conexion.Motor);
            var avisoPendientes = proveedor.Capacidades.SesionPorBase
                && activa.Sesion is not null
                && proveedor.TieneCambiosPendientes(activa.Sesion)
                && !string.Equals(baseAnterior, baseNueva, StringComparison.Ordinal)
                    ? $" Ojo: {baseAnterior ?? "la base anterior"} sigue con cambios sin confirmar en su propia sesión; vuelve a ella para hacer COMMIT o ROLLBACK, o decide al cerrar la pestaña."
                    : "";

            activa.BaseDatos = baseNueva;
            _enfocarEditor = true;
            StateHasChanged();
            await GuardarSesionAsync();

            await anunciador.AnunciarAsync($"{activa.Nombre} ahora usa {baseNueva ?? "la base predeterminada"}. Se conserva el texto del editor.{avisoPendientes}");
        });
    }

    [JSInvokable]
    public Task NuevaPestana(string? baseDatos)
    {
        return InvokeAsync(async () =>
        {
            var baseNueva = string.IsNullOrWhiteSpace(baseDatos) ? _pestanas.Activa?.BaseDatos ?? Conexion.Conexion.BaseDatosInicial : baseDatos;
            var pestana = AbrirPestana(baseNueva);
            _enfocarEditor = true;
            StateHasChanged();
            await GuardarSesionAsync();
            await anunciador.AnunciarAsync($"Pestaña nueva: {pestana.Nombre} en {baseNueva ?? "la base predeterminada"}, {Posicion(pestana)}.");
        });
    }

    [JSInvokable]
    public Task CambiarPestana(int desplazamiento)
    {
        return InvokeAsync(async () =>
        {
            if (_pestanas.Pestanas.Count == 0)
            {
                await anunciador.AnunciarAsync("No hay pestañas de consulta abiertas.");
                return;
            }

            if (_pestanas.Pestanas.Count == 1)
            {
                await anunciador.AnunciarAsync($"Solo hay una pestaña: {_pestanas.Activa!.Etiqueta}.");
                return;
            }

            var pestana = _pestanas.Mover(desplazamiento)!;
            _enfocarEditor = true;
            StateHasChanged();
            await GuardarSesionAsync();
            await anunciador.AnunciarAsync($"{pestana.Etiqueta}, {Posicion(pestana)}.");
        });
    }

    private async Task ActivarPestanaAsync(PestanaModelo pestana, bool enfocarEditor)
    {
        _pestanas.Activar(pestana);

        if (enfocarEditor)
        {
            _enfocarEditor = true;
        }
        else
        {
            _enfocarPestana = $"pestana-{pestana.Id}";
        }

        StateHasChanged();
        await GuardarSesionAsync();
    }

    private async Task TeclaPestanasAsync(KeyboardEventArgs e)
    {
        var activa = _pestanas.Activa;

        if (activa is null)
        {
            return;
        }

        var indice = _pestanas.Pestanas.IndexOf(activa);
        var total = _pestanas.Pestanas.Count;
        var destino = e.Key switch
        {
            "ArrowRight" => (indice + 1) % total,
            "ArrowLeft" => (indice - 1 + total) % total,
            "Home" => 0,
            "End" => total - 1,
            _ => -1
        };

        if (destino >= 0)
        {
            await ActivarPestanaAsync(_pestanas.Pestanas[destino], false);
        }
    }

    [JSInvokable]
    public Task CerrarPestana()
    {
        return InvokeAsync(async () =>
        {
            if (_pestanas.Activa is not { } pestana)
            {
                await anunciador.AnunciarAsync("No hay pestañas de consulta abiertas.");
                return;
            }

            await CerrarPestanaAsync(pestana);
        });
    }

    private async Task CerrarPestanaAsync(PestanaModelo pestana)
    {
        if (pestana.Ejecutando)
        {
            await anunciador.AnunciarAsync($"{pestana.Nombre} está ejecutando. Espera a que termine o cancélala antes de cerrarla.");
            return;
        }

        if (pestana.Modificado && !string.IsNullOrWhiteSpace(pestana.Texto))
        {
            var respuesta = archivos.PreguntarGuardarCambios(pestana.Nombre);

            if (respuesta == RespuestaGuardar.Cancelar
                || respuesta == RespuestaGuardar.Guardar && !await GuardarComoAsync(pestana, false))
            {
                _enfocarEditor = true;
                StateHasChanged();
                return;
            }
        }

        if (pestana.Sesion is not null && proveedores.Obtener(Conexion.Conexion.Motor).TieneCambiosPendientes(pestana.Sesion))
        {
            _pestanaPorCerrar = pestana;
            StateHasChanged();
            return;
        }

        await QuitarPestanaAsync(pestana, null);
    }

    private void NoCerrarPestana()
    {
        _pestanaPorCerrar = null;
        _enfocarEditor = true;
    }

    private async Task TerminarCierreAsync(bool confirmar)
    {
        var pestana = _pestanaPorCerrar!;
        _pestanaPorCerrar = null;
        await QuitarPestanaAsync(pestana, confirmar);
    }

    private async Task QuitarPestanaAsync(PestanaModelo pestana, bool? confirmar)
    {
        string? mensaje = null;

        if (pestana.Sesion is not null)
        {
            mensaje = await proveedores.Obtener(Conexion.Conexion.Motor).FinalizarSesionAsync(pestana.Sesion, confirmar ?? false);
        }

        var activa = _pestanas.Cerrar(pestana);
        StateHasChanged();
        await GuardarSesionAsync();

        var prefijo = confirmar is null || mensaje is null ? "" : $"{mensaje} ";

        if (activa is null)
        {
            if (_explorador is not null)
            {
                await _explorador.EnfocarAsync();
            }

            await Task.Delay(400);
            await anunciador.AnunciarAsync($"{prefijo}Pestaña {pestana.Nombre} cerrada. No quedan consultas abiertas.");
            return;
        }

        _enfocarEditor = true;
        StateHasChanged();
        await Task.Delay(400);
        await anunciador.AnunciarAsync($"{prefijo}Pestaña {pestana.Nombre} cerrada. Ahora estás en {activa.Etiqueta}, {Posicion(activa)}.");
    }

