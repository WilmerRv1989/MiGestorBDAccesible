    private async Task<bool> GuardarComoAsync(PestanaModelo pestana, bool comoNuevo)
    {
        var ruta = !comoNuevo && pestana.Archivo is not null
            ? pestana.Archivo
            : archivos.ElegirParaGuardar("Guardar consulta SQL", ArchivosService.FiltroSql, pestana.Archivo is null ? "consulta.sql" : pestana.Nombre, "sql");

        if (ruta is null)
        {
            await anunciador.AnunciarAsync("Guardado cancelado.");
            return false;
        }

        try
        {
            await archivos.GuardarAsync(ruta, pestana.Texto);
            pestana.Archivo = ruta;
            pestana.TextoGuardado = pestana.Texto;
            StateHasChanged();
            await GuardarSesionAsync();
            await anunciador.AnunciarAsync($"Guardado en {Path.GetFileName(ruta)}.");
            return true;
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo guardar el archivo. {ex.Message}");
            return false;
        }
    }

