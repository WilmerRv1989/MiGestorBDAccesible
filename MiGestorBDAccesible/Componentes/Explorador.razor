    public Task UbicarAsync(string baseDatos, ResultadoBusquedaObjetoModelo resultado)
    {
        return InvokeAsync(async () =>
        {
            var nodoBase = NodosBase().FirstOrDefault(n => string.Equals(n.BaseDatos, baseDatos, StringComparison.OrdinalIgnoreCase));

            if (nodoBase is null)
            {
                return;
            }

            await ExpandirAsync(nodoBase);
            var (destino, ultimo, ruta) = await BuscarNodoAsync(nodoBase, resultado);
            await TerminarUbicacionAsync(resultado, destino, ultimo, ruta);
        });
    }

    private async Task TerminarUbicacionAsync(ResultadoBusquedaObjetoModelo resultado, NodoArbolModelo? destino, NodoArbolModelo ultimo, string? ruta)
    {
        Activar(destino ?? ultimo);
        StateHasChanged();
        await Task.Delay(600);

        if (destino is null)
        {
            await anunciador.AnunciarAsync($"No encontré {BuscadorObjetosService.Describir(resultado)} en el árbol. Prueba con Actualizar.");
        }
        else if (ruta is not null)
        {
            await anunciador.AnunciarAsync(ruta);
        }
    }

    public Task AbrirBuscarObjetoAsync(string? baseDatos)
    {
        return InvokeAsync(async () =>
        {
            if (_carpetaBases is null)
            {
                return;
            }

            await ExpandirAsync(_carpetaBases);
            _basesBusqueda = NodosBase().Select(n => n.BaseDatos!).ToList();

            if (_basesBusqueda.Count == 0)
            {
                await anunciador.AnunciarAsync("No hay bases de datos donde buscar.");
                return;
            }

            _busquedaObjeto ??= new EstadoBusquedaObjetoModelo();
            var elegida = _basesBusqueda.FirstOrDefault(b => string.Equals(b, baseDatos, StringComparison.OrdinalIgnoreCase))
                ?? _basesBusqueda.FirstOrDefault(b => b == _busquedaObjeto.BaseDatos)
                ?? _basesBusqueda[0];

            if (elegida != _busquedaObjeto.BaseDatos)
            {
                _busquedaObjeto.BaseDatos = elegida;
                _busquedaObjeto.Resultados = null;
            }

            await js.InvokeVoidAsync("miGestor.recordarFoco");
            _buscarAbierto = true;
            StateHasChanged();
        });
    }

    private IEnumerable<NodoArbolModelo> NodosBase() =>
        (_carpetaBases?.Hijos ?? []).Where(n => n.Tipo == TipoNodo.BaseDatos && !n.EsSistema && n.BaseDatos is not null);

    private async Task CerrarBuscarObjetoAsync()
    {
