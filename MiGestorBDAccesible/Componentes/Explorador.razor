    private async Task ElegirResultadoBusquedaAsync(ResultadoBusquedaObjetoModelo resultado)
    {
        var baseDatos = _busquedaObjeto!.BaseDatos;
        var nodoBase = NodosBase().FirstOrDefault(n => string.Equals(n.BaseDatos, baseDatos, StringComparison.OrdinalIgnoreCase));

        if (nodoBase is null)
        {
            await CerrarBuscarObjetoAsync();
            return;
        }

        await ExpandirAsync(nodoBase);
        var (destino, ultimo, ruta) = await BuscarNodoAsync(nodoBase, resultado);

        _buscarAbierto = false;
        await TerminarUbicacionAsync(resultado, destino, ultimo, ruta);
    }

    private async Task<(NodoArbolModelo? Destino, NodoArbolModelo Ultimo, string? Ruta)> BuscarNodoAsync(NodoArbolModelo nodoBase, ResultadoBusquedaObjetoModelo resultado)
    {
        static bool Igual(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

        if (resultado.Tipo == TipoResultadoBusqueda.Tabla || resultado.Tabla is not null)
        {
            var tabla = resultado.Tabla ?? new TablaModelo { Esquema = resultado.Esquema, Nombre = resultado.Nombre };
            var carpetaTablas = nodoBase.Hijos?.FirstOrDefault(h => h.Tipo == TipoNodo.Carpeta && h.TipoCarpeta is null && h.CargarHijos is not null);

            if (carpetaTablas is null)
            {
                return (null, nodoBase, null);
            }

            await ExpandirAsync(carpetaTablas);
            var nodoTabla = carpetaTablas.Hijos?.FirstOrDefault(h => h.Tabla is not null && Igual(h.Tabla.NombreCompleto, tabla.NombreCompleto));

            if (nodoTabla is null || resultado.Tipo == TipoResultadoBusqueda.Tabla)
            {
                return (nodoTabla, carpetaTablas, null);
            }

            await ExpandirAsync(nodoTabla);

            (Func<NodoArbolModelo, bool> EsCarpeta, Func<NodoArbolModelo, bool> EsHijo) criterio = resultado.Tipo switch
            {
                TipoResultadoBusqueda.Columna => (c => c.Texto.StartsWith("Columnas"), h => Igual(h.Nombre, resultado.Nombre)),
                TipoResultadoBusqueda.Indice => (c => c.Texto.StartsWith("Índices"), h => Igual(h.Indice?.Nombre, resultado.Nombre)),
                TipoResultadoBusqueda.Check => (c => c.Texto.StartsWith("Restricciones CHECK"), h => Igual(h.Check?.Nombre, resultado.Nombre)),
                TipoResultadoBusqueda.Disparador => (c => c.Texto.StartsWith("Disparadores"), h => Igual(h.Objeto?.Nombre, resultado.Nombre)),
                _ => (c => c.Texto == "Llaves", h => Igual(h.Nombre, resultado.Nombre))
            };

            var subcarpeta = nodoTabla.Hijos?.FirstOrDefault(criterio.EsCarpeta);

            if (subcarpeta is null)
            {
                return (null, nodoTabla, null);
            }

            await ExpandirAsync(subcarpeta);
            var titulo = subcarpeta.Texto.Split(" (")[0];
            return (subcarpeta.Hijos?.FirstOrDefault(criterio.EsHijo), subcarpeta, $"En {titulo} de {nodoTabla.Texto}.");
        }

        var tipo = resultado.Tipo switch
        {
            TipoResultadoBusqueda.Vista => TipoObjeto.Vista,
            TipoResultadoBusqueda.Procedimiento => TipoObjeto.Procedimiento,
            TipoResultadoBusqueda.Funcion => TipoObjeto.Funcion,
            TipoResultadoBusqueda.Paquete or TipoResultadoBusqueda.Subprograma => TipoObjeto.Paquete,
            TipoResultadoBusqueda.Secuencia => TipoObjeto.Secuencia,
            _ => TipoObjeto.Disparador
        };

        var carpeta = nodoBase.Hijos?.FirstOrDefault(h => h.TipoCarpeta == tipo);

        if (carpeta is null)
        {
            return (null, nodoBase, null);
        }

        await ExpandirAsync(carpeta);
        var nombre = resultado.Tipo == TipoResultadoBusqueda.Subprograma ? resultado.Detalle : resultado.Nombre;
        var destino = carpeta.Hijos?.FirstOrDefault(h => h.Objeto is { } o &&
            (resultado.Id is not null && o.Id is not null
                ? o.Id == resultado.Id
                : Igual(o.Nombre, nombre) && (o.Esquema == "" || resultado.Esquema == "" || Igual(o.Esquema, resultado.Esquema))));

        return (destino, carpeta, resultado.Tipo == TipoResultadoBusqueda.Subprograma ? $"{resultado.Nombre} está dentro de este paquete." : null);
    }

