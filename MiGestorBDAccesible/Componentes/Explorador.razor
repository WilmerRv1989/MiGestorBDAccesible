    public Task MostrarTablaAsync(string baseDatos, TablaModelo tabla, string aviso)
    {
        return InvokeAsync(async () =>
        {
            var nodoBase = Visitar(_carpetaBases!).FirstOrDefault(n =>
                n.Tipo == TipoNodo.BaseDatos && string.Equals(n.BaseDatos, baseDatos, StringComparison.OrdinalIgnoreCase));

            if (nodoBase is null)
            {
                await anunciador.AnunciarAsync(aviso);
                return;
            }

            await ExpandirAsync(nodoBase);
            var carpeta = nodoBase.Hijos?.FirstOrDefault(h => h.Tipo == TipoNodo.Carpeta && h.CargarHijos is not null);

            if (carpeta is null)
            {
                Activar(nodoBase);
            }
            else
            {
                await RecargarAsync(carpeta);
                var nodoTabla = carpeta.Hijos?.FirstOrDefault(h =>
                    h.Tabla is not null && string.Equals(h.Tabla.NombreCompleto, tabla.NombreCompleto, StringComparison.OrdinalIgnoreCase));
                Activar(nodoTabla ?? carpeta);
            }

            StateHasChanged();
            await Task.Delay(600);
            await anunciador.AnunciarAsync(aviso);
        });
    }

    private static IEnumerable<NodoArbolModelo> Visitar(NodoArbolModelo nodo)
    {
        yield return nodo;

        foreach (var hijo in nodo.Hijos ?? [])
        {
            foreach (var descendiente in Visitar(hijo))
            {
                yield return descendiente;
            }
        }
    }

