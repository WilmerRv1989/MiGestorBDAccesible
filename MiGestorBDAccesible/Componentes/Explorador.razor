    private async Task<bool> EjecutarDialogoAsync(string? baseDatos, string sql)
    {
        _procesando = true;
        _errorDialogo = null;
        StateHasChanged();

        var resultado = await _proveedor.EjecutarAsync(Conexion, baseDatos, sql, 1);
        var error = resultado.Errores.FirstOrDefault();
        _procesando = false;

        if (error is null)
        {
            return true;
        }

        _errorDialogo = $"No se pudo completar. {error.Texto}";
        await anunciador.AnunciarUrgenteAsync(_errorDialogo);
        return false;
    }

    private async Task CrearBaseAsync()
    {
        var nombre = _nombreBase?.Trim() ?? "";

        if (nombre.Length == 0 || !await EjecutarDialogoAsync(_proveedor.BaseDatosAdministracion, _proveedor.ScriptCrearBaseDatos(nombre)))
        {
            return;
        }

        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await RecargarAsync(_carpetaBases!);

        var nueva = _carpetaBases!.Hijos?.FirstOrDefault(h => string.Equals(h.BaseDatos, nombre, StringComparison.OrdinalIgnoreCase));
        Activar(nueva ?? _carpetaBases);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"Base de datos {nombre} creada.");
    }

    private async Task EliminarBaseAsync()
    {
        var nombre = _nodoDialogo!.BaseDatos!;

        if (!await EjecutarDialogoAsync(_proveedor.BaseDatosAdministracion, _proveedor.ScriptEliminarBaseDatos(nombre)))
        {
            return;
        }

        _proveedor.ReiniciarConexiones();
        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await RecargarAsync(_carpetaBases!);
        Activar(_carpetaBases!);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"Base de datos {nombre} eliminada.");
    }

    private async Task EliminarTablaAsync()
    {
        var nodo = _nodoDialogo!;

        if (!await EjecutarDialogoAsync(nodo.BaseDatos, _proveedor.ScriptEliminarTabla(nodo.Tabla!, _purgar)))
        {
            return;
        }

        var carpeta = nodo.Padre!;
        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await RecargarAsync(carpeta);
        Activar(carpeta);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync(_proveedor.Capacidades.TienePapelera && !_purgar
            ? $"Tabla {nodo.Tabla!.NombreCompleto} eliminada; quedó en la papelera de reciclaje."
            : $"Tabla {nodo.Tabla!.NombreCompleto} eliminada.");
    }

    private async Task ClicAsync(NodoArbolModelo nodo)
    {
        Activar(nodo);
        await AccionPrincipalAsync(nodo);
    }

    private async Task AccionPrincipalAsync(NodoArbolModelo nodo)
    {
        if (nodo.Tipo is TipoNodo.Tabla or TipoNodo.Objeto)
        {
            await AlDescribir.InvokeAsync(nodo);
        }
        else if (nodo.PuedeExpandirse && nodo.Padre is not null)
        {
            if (nodo.Expandido)
            {
                nodo.Expandido = false;
            }
            else
            {
                await ExpandirAsync(nodo);
            }
        }
    }

    private void Activar(NodoArbolModelo nodo)
    {
        _activo = nodo;
        _enfocarPendiente = nodo.Id;
    }

    private async Task ExpandirAsync(NodoArbolModelo nodo)
    {
        if (nodo.Hijos is null && nodo.CargarHijos is not null)
        {
            nodo.Cargando = true;
            StateHasChanged();

            try
            {
                var carga = nodo.CargarHijos(nodo);

                if (await Task.WhenAny(carga, Task.Delay(1000)) != carga)
                {
                    await anunciador.AnunciarAsync($"Cargando {nodo.Texto}…");
                }

                var hijos = await carga;
                nodo.Hijos = hijos.Count > 0 ? hijos : [Mensaje("Vacío", nodo)];
            }
            catch (Exception ex)
            {
                nodo.Hijos = [Mensaje($"No se pudo cargar: {ex.Message}", nodo)];
                await anunciador.AnunciarUrgenteAsync($"No se pudo cargar {nodo.Texto}. {ex.Message}");
            }
            finally
            {
                nodo.Cargando = false;
            }
        }

        nodo.Expandido = true;
    }

    private List<NodoArbolModelo> Visibles()
    {
        var lista = new List<NodoArbolModelo>();
        Agregar(_raiz!, lista);
        return lista;

        static void Agregar(NodoArbolModelo nodo, List<NodoArbolModelo> lista)
        {
            lista.Add(nodo);

            if (nodo.Expandido && nodo.Hijos is not null)
            {
                foreach (var hijo in nodo.Hijos)
                {
                    Agregar(hijo, lista);
                }
            }
        }
    }

    private async Task<List<NodoArbolModelo>> CargarBasesDatosAsync(NodoArbolModelo carpeta)
    {
        var bases = await _proveedor.ObtenerBasesDatosAsync(Conexion);
        var nodos = bases.Where(b => !b.EsSistema).Select(b => NodoBaseDatos(b, carpeta)).ToList();
        var sistema = bases.Where(b => b.EsSistema).ToList();

        if (sistema.Count > 0)
        {
            var carpetaSistema = new NodoArbolModelo
            {
                Texto = _proveedor.Capacidades.ContenedoresSistemaTitulo,
                Tipo = TipoNodo.Carpeta,
                Padre = carpeta
            };

            carpetaSistema.Hijos = sistema.Select(b => NodoBaseDatos(b, carpetaSistema)).ToList();
            nodos.Add(carpetaSistema);
        }

        return nodos;
    }

    private NodoArbolModelo NodoBaseDatos(BaseDatosModelo baseDatos, NodoArbolModelo padre) => new()
    {
        Texto = baseDatos.EnLinea ? baseDatos.Nombre : $"{baseDatos.Nombre} (sin acceso)",
        Tipo = TipoNodo.BaseDatos,
        Padre = padre,
        BaseDatos = baseDatos.Nombre,
        EsSistema = baseDatos.EsSistema,
        CargarHijos = baseDatos.EnLinea ? CargarCarpetasBaseDatosAsync : null
    };

    private async Task<List<NodoArbolModelo>> CargarCarpetasBaseDatosAsync(NodoArbolModelo nodoBase)
    {
        List<NodoArbolModelo> carpetas =
        [
            new()
            {
                Texto = "Tablas",
                Tipo = TipoNodo.Carpeta,
                Padre = nodoBase,
                TemasAyuda = ["concepto:tabla"],
                BaseDatos = nodoBase.BaseDatos,
                CargarHijos = CargarTablasAsync
            }
        ];

        Dictionary<TipoObjeto, int>? cuentas = null;

        try
        {
            cuentas = await _proveedor.ContarObjetosAsync(Conexion, nodoBase.BaseDatos!);
        }
        catch (Exception ex) when (ex is not ConexionPerdidaException)
        {
        }

        foreach (var tipo in _proveedor.Capacidades.TiposObjeto)
        {
            carpetas.Add(CarpetaObjetos(tipo, tipo.Plural(), nodoBase, cuentas?.GetValueOrDefault(tipo)));
        }

        if (cuentas?.GetValueOrDefault(TipoObjeto.Disparador) > 0)
        {
            carpetas.Add(CarpetaObjetos(TipoObjeto.Disparador, _proveedor.Capacidades.TituloDisparadoresBase, nodoBase, cuentas[TipoObjeto.Disparador]));
        }

        return carpetas;
    }

    private NodoArbolModelo CarpetaObjetos(TipoObjeto tipo, string titulo, NodoArbolModelo nodoBase, int? cantidad) => new()
    {
        Texto = cantidad is null ? titulo : $"{titulo} ({cantidad})",
        Tipo = TipoNodo.Carpeta,
        Padre = nodoBase,
        TemasAyuda = tipo.TemasAyuda(),
        BaseDatos = nodoBase.BaseDatos,
        TipoCarpeta = tipo,
        CargarHijos = carpeta => CargarObjetosAsync(carpeta, tipo, titulo)
    };

    private async Task<List<NodoArbolModelo>> CargarObjetosAsync(NodoArbolModelo carpeta, TipoObjeto tipo, string titulo)
    {
        var objetos = await _proveedor.ObtenerObjetosAsync(Conexion, carpeta.BaseDatos!, tipo);
        carpeta.Texto = $"{titulo} ({objetos.Count})";
        return objetos.Select(o => NodoObjeto(o, carpeta)).ToList();
    }

    private static NodoArbolModelo NodoObjeto(ObjetoBaseDatosModelo objeto, NodoArbolModelo padre) => new()
    {
        Texto = objeto.Materializada ? $"{objeto.Texto} (materializada)" : objeto.Texto,
        Tipo = TipoNodo.Objeto,
        Padre = padre,
        BaseDatos = padre.BaseDatos,
        Objeto = objeto,
        TemasAyuda = objeto.Tipo.TemasAyuda()
    };

    private async Task<List<NodoArbolModelo>> CargarTablasAsync(NodoArbolModelo carpeta)
    {
        var tablas = await _proveedor.ObtenerTablasAsync(Conexion, carpeta.BaseDatos!);

        return tablas.Select(t => new NodoArbolModelo
        {
            Texto = t.NombreCompleto,
            Tipo = TipoNodo.Tabla,
            Padre = carpeta,
            BaseDatos = carpeta.BaseDatos,
            Tabla = t,
            TemasAyuda = ["concepto:tabla", "concepto:clave-principal", "concepto:llave-foranea"],
            CargarHijos = CargarPartesTablaAsync
        }).ToList();
    }

    private async Task<List<NodoArbolModelo>> CargarPartesTablaAsync(NodoArbolModelo nodoTabla)
    {
        var detalle = await _proveedor.ObtenerDetalleTablaAsync(Conexion, nodoTabla.BaseDatos!, nodoTabla.Tabla!);
        var disparadores = await _proveedor.ObtenerDisparadoresTablaAsync(Conexion, nodoTabla.BaseDatos!, nodoTabla.Tabla!);

        var carpetas = new List<NodoArbolModelo>
        {
            Carpeta($"Columnas ({detalle.Columnas.Count})", nodoTabla, ["concepto:tabla", "concepto:null"],
                padre => detalle.Columnas.Select(c =>
                    Elemento(narrador.DescribirColumna(c, detalle, _proveedor.Capacidades.Terminos), padre, TemasColumna(c, detalle), c.Nombre))),

            Carpeta("Llaves", nodoTabla, ["concepto:clave-principal", "concepto:llave-foranea", "concepto:unique"],
                padre => Llaves(detalle).Select(l => Elemento(l.Texto, padre, l.Temas, l.Nombre))),

            Carpeta($"Índices ({detalle.Indices.Count})", nodoTabla, ["concepto:indice"],
                padre => detalle.Indices.Select(i => new NodoArbolModelo
                {
                    Texto = NarradorTablaService.DescribirIndice(i, _proveedor.Capacidades.Terminos),
                    Tipo = TipoNodo.Elemento,
                    Padre = padre,
                    TemasAyuda = ["concepto:indice"],
                    Indice = i
                }))
        };

        if (detalle.Restricciones.Count > 0)
        {
            carpetas.Add(Carpeta($"Restricciones CHECK ({detalle.Restricciones.Count})", nodoTabla, ["concepto:check"],
                padre => detalle.Restricciones.Select(r => new NodoArbolModelo
                {
                    Texto = $"{r.Nombre}: {NarradorTablaService.QuitarParentesisExternos(r.Definicion)}",
                    Tipo = TipoNodo.Elemento,
                    Padre = padre,
                    TemasAyuda = ["concepto:check"],
                    Check = r
                })));
        }

        var carpetaDisparadores = new NodoArbolModelo
        {
            Texto = $"Disparadores ({disparadores.Count})",
            Tipo = TipoNodo.Carpeta,
            Padre = nodoTabla,
            BaseDatos = nodoTabla.BaseDatos,
            TemasAyuda = TipoObjeto.Disparador.TemasAyuda()
        };
        carpetaDisparadores.Hijos = disparadores.Count > 0
            ? disparadores.Select(d => NodoObjeto(d, carpetaDisparadores)).ToList()
            : [Mensaje("Ninguno", carpetaDisparadores)];
        carpetas.Add(carpetaDisparadores);

        return carpetas;
    }

    private static List<string> TemasColumna(ColumnaModelo columna, DetalleTablaModelo detalle)
    {
        var comparador = StringComparer.OrdinalIgnoreCase;
        var temas = new List<string> { $"tipo:{columna.TipoDatos}" };

        if (detalle.ClavePrincipal?.ColumnasClave.Contains(columna.Nombre, comparador) == true)
        {
            temas.Add("concepto:clave-principal");
        }

        if (columna.EsIdentidad)
        {
            temas.Add("concepto:identity");
        }

        if (detalle.LlavesForaneas.Any(l => l.ColumnasOrigen.Contains(columna.Nombre, comparador)))
        {
            temas.Add("concepto:llave-foranea");
        }

        if (detalle.Indices.Any(i => i.EsUnico && !i.EsClavePrincipal && i.ColumnasClave.Contains(columna.Nombre, comparador)))
        {
            temas.Add("concepto:unique");
        }

        if (columna.EsCalculada)
        {
            temas.Add("concepto:columna-calculada");
        }

        if (columna.ValorPredeterminado is not null)
        {
            temas.Add("concepto:default");
        }

        temas.Add("concepto:null");
        return temas;
    }

    private static IEnumerable<(string Texto, List<string> Temas, string Nombre)> Llaves(DetalleTablaModelo detalle)
    {
        if (detalle.ClavePrincipal is { } clave)
        {
            yield return ($"Clave principal (PRIMARY KEY) {clave.Nombre}: {NarradorTablaService.Unir(clave.ColumnasClave)}",
                ["concepto:clave-principal"], clave.Nombre);
        }

        foreach (var llave in detalle.LlavesForaneas)
        {
            var destino = NarradorTablaService.Unir(llave.ColumnasDestino.Select(c => $"{llave.TablaDestino.NombreCorto()}.{c}"));
            yield return ($"Llave foránea (FOREIGN KEY) {llave.Nombre}: {NarradorTablaService.Unir(llave.ColumnasOrigen)} hacia {destino}",
                ["concepto:llave-foranea", "concepto:reglas-referenciales", "concepto:uno-a-muchos"], llave.Nombre);
        }

        foreach (var indice in detalle.Indices.Where(i => i.EsRestriccionUnica))
        {
            yield return ($"Restricción de valor único (UNIQUE) {indice.Nombre}: {NarradorTablaService.Unir(indice.ColumnasClave)}",
                ["concepto:unique"], indice.Nombre);
        }
    }

    private static NodoArbolModelo Carpeta(string texto, NodoArbolModelo padre, List<string> temas,
        Func<NodoArbolModelo, IEnumerable<NodoArbolModelo>> crearHijos)
    {
        var carpeta = new NodoArbolModelo { Texto = texto, Tipo = TipoNodo.Carpeta, Padre = padre, TemasAyuda = temas };
        var hijos = crearHijos(carpeta).ToList();
        carpeta.Hijos = hijos.Count > 0 ? hijos : [Mensaje("Ninguna", carpeta)];
        return carpeta;
    }

    private static NodoArbolModelo Elemento(string texto, NodoArbolModelo padre, List<string> temas, string? nombre = null) =>
        new() { Texto = texto, Tipo = TipoNodo.Elemento, Padre = padre, TemasAyuda = temas, Nombre = nombre };

    private static NodoArbolModelo Mensaje(string texto, NodoArbolModelo padre) =>
        new() { Texto = texto, Tipo = TipoNodo.Mensaje, Padre = padre };
}
