    private void ElegirTablaIntermedia(bool primera, string? clave)
    {
        if (primera)
        {
            _intermediaA = clave ?? "";
        }
        else
        {
            _intermediaB = clave ?? "";
        }

        var a = _destinosDialogo.FirstOrDefault(d => d.Clave == _intermediaA);
        var b = _destinosDialogo.FirstOrDefault(d => d.Clave == _intermediaB);

        if (!_intermediaNombreEditado && a is not null && b is not null)
        {
            _intermediaNombre = $"{a.Tabla.Nombre}{_proveedor.Capacidades.Terminos.SeparadorNombres}{b.Tabla.Nombre}";
        }
    }

    private async Task PrepararIntermediaAsync()
    {
        var a = _destinosDialogo.FirstOrDefault(d => d.Clave == _intermediaA);
        var b = _destinosDialogo.FirstOrDefault(d => d.Clave == _intermediaB);

        _errorDialogo = a is null || b is null ? "Elige las dos tablas que vas a relacionar."
            : a.Clave == b.Clave ? "Elige dos tablas distintas."
            : string.IsNullOrWhiteSpace(_intermediaNombre) ? "Escribe el nombre de la tabla intermedia."
            : null;

        if (_errorDialogo is not null)
        {
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var definicion = new DefinicionTablaModelo { Nombre = _intermediaNombre.Trim(), Esquema = _proveedor.EsquemaPredeterminado(Conexion) };

        foreach (var destino in new[] { a!, b! })
        {
            var columna = new DefinicionColumnaModelo
            {
                Nombre = $"{destino.Tabla.Nombre}{_proveedor.Capacidades.Terminos.SeparadorNombres}{destino.Columna}",
                EsClavePrincipal = true,
                Referencia = new ReferenciaModelo
                {
                    TablaDestino = destino.Tabla,
                    ColumnaDestino = destino.Columna,
                    TipoDestino = destino.TipoDatos
                }
            };

            columna.AplicarTipo(destino.TipoDatos, _proveedor.TiposDatos);
            definicion.Columnas.Add(columna);
        }

        var nodo = _nodoDialogo!;
        var mensaje = $"Tabla intermedia preparada: {definicion.Nombre}, con {definicion.Columnas[0].Nombre} y {definicion.Columnas[1].Nombre} como clave compuesta y llaves foráneas hacia {a!.Tabla.NombreCorto()} y {b!.Tabla.NombreCorto()}. Agrega las columnas extra que necesites, como una cantidad, y pulsa Crear tabla.";

        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await AlNuevaTabla.InvokeAsync(new SolicitudTablaModelo(nodo.BaseDatos!, definicion, mensaje));
    }

