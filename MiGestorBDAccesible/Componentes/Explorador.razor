    private async Task AbrirNuevoIndiceAsync(NodoArbolModelo tabla)
    {
        if (!await PrepararDialogoTablaAsync(tabla, Dialogo.NuevoIndice))
        {
            return;
        }

        if (_borradoresIndice.Remove(tabla.Tabla!.NombreCompleto, out var borrador))
        {
            _defIndice = borrador;
            _nombreIndiceEditado = true;
            await anunciador.AnunciarAsync("Se recuperó lo que habías preparado para este índice.");
        }
        else
        {
            _defIndice = new DefinicionIndiceModelo { Tabla = tabla.Tabla! };
            _nombreIndiceEditado = false;
        }

        _enfocarPendiente = "indice-columna";
        StateHasChanged();
    }

    private async Task AbrirNuevoCheckAsync(NodoArbolModelo tabla)
    {
        if (!await PrepararDialogoTablaAsync(tabla, Dialogo.NuevoCheck))
        {
            return;
        }

        if (_borradoresCheck.Remove(tabla.Tabla!.NombreCompleto, out var borrador))
        {
            (_defCheck, _checkConAsistente, _checkColumna, _checkComparacion, _checkValor, _checkValor2, _checkManual) = borrador;
            _nombreCheckEditado = true;
            await anunciador.AnunciarAsync("Se recuperó lo que habías preparado para esta restricción.");
        }
        else
        {
            _defCheck = new DefinicionCheckModelo { Tabla = tabla.Tabla! };
            _nombreCheckEditado = false;
            _checkConAsistente = true;
            _checkColumna = "";
            _checkComparacion = ComparacionCheck.MayorOIgual;
            _checkValor = "";
            _checkValor2 = "";
            _checkManual = "";
        }

        _enfocarPendiente = _checkConAsistente ? "check-columna" : "check-condicion";
        StateHasChanged();
    }

    private async Task<bool> PrepararDialogoTablaAsync(NodoArbolModelo tabla, Dialogo dialogo)
    {
        _nodoDialogo = tabla;
        _detalleDialogo = null;
        _errorDialogo = null;
        _comprobacionesDialogo = [];
        _columnaIndiceElegida = "";
        _incluidaElegida = "";
        _dialogo = dialogo;
        StateHasChanged();

        try
        {
            _detalleDialogo = await _proveedor.ObtenerDetalleTablaAsync(Conexion, tabla.BaseDatos!, tabla.Tabla!);
            return true;
        }
        catch (Exception ex)
        {
            _errorDialogo = $"No se pudo revisar la tabla. {ex.Message}";
            StateHasChanged();
            return false;
        }
    }

    private bool TieneOpcionesAvanzadas()
    {
        var capacidades = _proveedor.Capacidades;
        return capacidades.Terminos.TieneIndicesAgrupados || capacidades.IndiceIncluye || capacidades.IndiceFiltrado
            || capacidades.MetodosIndice.Count > 0 || capacidades.IndiceConcurrente;
    }

    private IndiceModelo? IndiceRepetido()
    {
        var columnas = _defIndice.Columnas.Select(c => c.Nombre).ToList();

        return columnas.Count == 0
            ? null
            : _detalleDialogo?.Indices.FirstOrDefault(i => i.ColumnasClave.SequenceEqual(columnas, StringComparer.OrdinalIgnoreCase));
    }

    private void ActualizarNombreIndice()
    {
        if (!_nombreIndiceEditado && _nodoDialogo?.Tabla is { } tabla)
        {
            _defIndice.Nombre = _defIndice.Columnas.Count == 0 ? "" : $"IX_{tabla.Nombre}_{string.Join("_", _defIndice.Columnas.Select(c => c.Nombre))}";
        }
    }

    private async Task AgregarColumnaIndiceAsync()
    {
        if (_columnaIndiceElegida.Length == 0)
        {
            await anunciador.AnunciarUrgenteAsync("Elige primero una columna de la lista.");
            return;
        }

        var nombre = _columnaIndiceElegida;
        _defIndice.Columnas.Add(new ColumnaDefinicionIndiceModelo { Nombre = nombre });
        _columnaIndiceElegida = "";
        _comprobacionesDialogo = [];
        ActualizarNombreIndice();
        _enfocarPendiente = "indice-columna";
        StateHasChanged();
        await Task.Delay(300);
        await anunciador.AnunciarAsync($"{nombre} agregada al índice: es la columna {_defIndice.Columnas.Count}. {IndiceRepetido()?.Nombre switch { null => "", var n => $"Ojo: el índice {n} ya tiene estas mismas columnas." }}");
    }

    private void CambiarOrdenIndice(int indice)
    {
        _defIndice.Columnas[indice].Descendente = !_defIndice.Columnas[indice].Descendente;
        _enfocarPendiente = $"indice-col-{indice}-orden";
    }

    private void MoverColumnaIndice(int indice, int direccion)
    {
        var columna = _defIndice.Columnas[indice];
        _defIndice.Columnas.RemoveAt(indice);
        _defIndice.Columnas.Insert(indice + direccion, columna);
        _comprobacionesDialogo = [];
        ActualizarNombreIndice();
        var destino = indice + direccion;
        var boton = direccion < 0 ? (destino > 0 ? "subir" : "bajar") : (destino < _defIndice.Columnas.Count - 1 ? "bajar" : "subir");
        _enfocarPendiente = $"indice-col-{destino}-{boton}";
        _ = anunciador.AnunciarAsync($"{columna.Nombre} ahora es la columna {destino + 1} de {_defIndice.Columnas.Count}.");
    }

    private void QuitarColumnaIndice(int indice)
    {
        var columna = _defIndice.Columnas[indice];
        _defIndice.Columnas.RemoveAt(indice);
        _comprobacionesDialogo = [];
        ActualizarNombreIndice();
        _enfocarPendiente = "indice-columna";
        _ = anunciador.AnunciarAsync($"{columna.Nombre} quitada del índice. Quedan {_defIndice.Columnas.Count}.");
    }

    private async Task AgregarIncluidaAsync()
    {
        if (_incluidaElegida.Length == 0)
        {
            await anunciador.AnunciarUrgenteAsync("Elige primero la columna que quieres incluir.");
            return;
        }

        _defIndice.Incluidas.Add(_incluidaElegida);
        await anunciador.AnunciarAsync($"{_incluidaElegida} incluida en el índice.");
        _incluidaElegida = "";
    }

    private DefinicionIndiceModelo DefinicionIndiceFinal() => new()
    {
        Tabla = _defIndice.Tabla,
        Nombre = _defIndice.Nombre,
        Columnas = _defIndice.Columnas,
        EsUnico = _defIndice.EsUnico,
        EsAgrupado = _defIndice.EsAgrupado && _detalleDialogo?.Indices.Any(i => i.EsAgrupado) == false,
        Incluidas = _proveedor.Capacidades.IndiceIncluye ? _defIndice.Incluidas : [],
        Filtro = _proveedor.Capacidades.IndiceFiltrado ? _defIndice.Filtro : null,
        Metodo = _defIndice.Metodo,
        Concurrente = _defIndice.Concurrente
    };

    private async Task CrearIndiceAsync()
    {
        if (_defIndice.Columnas.Count == 0)
        {
            _errorDialogo = "Agrega al menos una columna al índice.";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        if (string.IsNullOrWhiteSpace(_defIndice.Nombre))
        {
            _errorDialogo = "Escribe el nombre del índice.";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var definicion = DefinicionIndiceFinal();

        if (!await ComprobarDialogoAsync(() => comprobador.ComprobarIndiceAsync(_proveedor, Conexion, _nodoDialogo!.BaseDatos!, definicion)))
        {
            return;
        }

        var tabla = _nodoDialogo!;

        if (!await EjecutarDialogoAsync(tabla.BaseDatos, _proveedor.ScriptCrearIndice(definicion)))
        {
            return;
        }

        await TerminarDialogoTablaAsync(tabla, $"Índice {_proveedor.NombreGuardado(definicion.Nombre)} creado sobre {NarradorTablaService.Unir(definicion.Columnas.Select(c => c.Nombre))}.");
    }

    private string? CondicionCheck()
    {
        if (!_checkConAsistente)
        {
            return string.IsNullOrWhiteSpace(_checkManual) ? null : _checkManual.Trim();
        }

        var columna = _detalleDialogo?.Columnas.FirstOrDefault(c => c.Nombre == _checkColumna);

        return columna is null
            ? null
            : AsistenteCheckService.Condicion(_proveedor.Dialecto, columna.Nombre, columna.TipoDatos, _checkComparacion, _checkValor, _checkValor2);
    }

    private void ActualizarNombreCheck()
    {
        if (!_nombreCheckEditado && _nodoDialogo?.Tabla is { } tabla)
        {
            _defCheck.Nombre = _checkColumna.Length == 0 ? "" : $"CK_{tabla.Nombre}_{_checkColumna}";
        }
    }

    private DefinicionCheckModelo DefinicionCheckFinal() => new()
    {
        Tabla = _defCheck.Tabla,
        Nombre = string.IsNullOrWhiteSpace(_defCheck.Nombre) ? $"CK_{_defCheck.Tabla.Nombre}" : _defCheck.Nombre,
        Condicion = CondicionCheck() ?? "",
        ComprobarExistentes = _defCheck.ComprobarExistentes
    };

    private string EjemplosCheck()
    {
        var ejemplos = new List<string>();
        var columnas = _detalleDialogo?.Columnas ?? [];
        var d = _proveedor.Dialecto;

        if (columnas.FirstOrDefault(c => EsNumero(c.TipoDatos)) is { } numero)
        {
            ejemplos.Add($"{d.Columna(numero.Nombre)} >= 0");
        }

        if (columnas.FirstOrDefault(c => EsTexto(c.TipoDatos)) is { } texto)
        {
            ejemplos.Add($"{d.Columna(texto.Nombre)} IN ('A', 'B')");
        }

        if (columnas.Count(c => EsFecha(c.TipoDatos)) >= 2)
        {
            var fechas = columnas.Where(c => EsFecha(c.TipoDatos)).Take(2).ToList();
            ejemplos.Add($"{d.Columna(fechas[1].Nombre)} >= {d.Columna(fechas[0].Nombre)}");
        }

        return ejemplos.Count == 0
            ? "Escríbela como en un WHERE, usando las columnas de la tabla."
            : $"Escríbela como en un WHERE. Por ejemplo: {string.Join("; o ", ejemplos)}.";

        static bool EsNumero(string tipo) => System.Text.RegularExpressions.Regex.IsMatch(tipo, @"^(int|bigint|smallint|tinyint|decimal|numeric|money|float|real|integer|number|double)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        static bool EsTexto(string tipo) => System.Text.RegularExpressions.Regex.IsMatch(tipo, @"char|text", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        static bool EsFecha(string tipo) => System.Text.RegularExpressions.Regex.IsMatch(tipo, @"date|time", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private async Task CrearCheckAsync()
    {
        var condicion = CondicionCheck();

        if (condicion is null)
        {
            _errorDialogo = _checkConAsistente ? "Elige la columna y escribe el valor de la condición." : "Escribe la condición.";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var definicion = DefinicionCheckFinal();

        if (!await ComprobarDialogoAsync(() => comprobador.ComprobarCheckAsync(_proveedor, Conexion, _nodoDialogo!.BaseDatos!, definicion)))
        {
            return;
        }

        var tabla = _nodoDialogo!;

        if (!await EjecutarDialogoAsync(tabla.BaseDatos, _proveedor.ScriptCrearCheck(definicion)))
        {
            return;
        }

        await TerminarDialogoTablaAsync(tabla, $"Restricción CHECK {_proveedor.NombreGuardado(definicion.Nombre)} creada: {condicion}.");
    }

    private async Task<bool> ComprobarDialogoAsync(Func<Task<List<ComprobacionModelo>>> comprobar)
    {
        _procesando = true;
        _errorDialogo = null;
        StateHasChanged();

        try
        {
            _comprobacionesDialogo = await comprobar();
        }
        catch (Exception ex)
        {
            _procesando = false;
            _errorDialogo = $"No se pudo revisar los datos con esa condición. {ex.Message}";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return false;
        }

        _procesando = false;

        if (_comprobacionesDialogo.Count == 0)
        {
            return true;
        }

        _enfocarPendiente = "titulo-comprobaciones-dialogo";
        StateHasChanged();
        await Task.Delay(400);
        var cantidad = _comprobacionesDialogo.Count == 1 ? "1 problema" : $"{_comprobacionesDialogo.Count} problemas";
        await anunciador.AnunciarUrgenteAsync($"No se puede crear todavía: {cantidad}. {_comprobacionesDialogo[0].Mensaje}");
        return false;
    }

    private async Task VerFilasDialogoAsync(string consulta)
    {
        var tabla = _nodoDialogo!;

        if (_dialogo == Dialogo.NuevoIndice)
        {
            _borradoresIndice[tabla.Tabla!.NombreCompleto] = _defIndice;
        }
        else
        {
            _borradoresCheck[tabla.Tabla!.NombreCompleto] = (_defCheck, _checkConAsistente, _checkColumna, _checkComparacion, _checkValor, _checkValor2, _checkManual);
        }

        CerrarDialogo();
        await AlAbrirScript.InvokeAsync(new ScriptAbiertoModelo(tabla.BaseDatos, consulta, true, "Filas que impiden el cambio"));
    }

    private async Task TerminarDialogoTablaAsync(NodoArbolModelo tabla, string aviso)
    {
        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        _comprobacionesDialogo = [];
        await RecargarAsync(tabla);
        Activar(tabla);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync(aviso);
    }

    private async Task AbrirEliminarIndiceAsync(NodoArbolModelo nodo)
    {
        var indice = nodo.Indice!;

        if (indice.EsClavePrincipal || indice.EsRestriccionUnica)
        {
            await anunciador.AnunciarAsync($"El índice {indice.Nombre} sostiene {(indice.EsClavePrincipal ? "la clave principal" : "una restricción de valor único (UNIQUE)")}. Para quitarlo usa Modificar tabla.");
            return;
        }

        _nodoDialogo = nodo;
        _errorDialogo = null;
        _avisoEliminarIndice = null;
        _dialogo = Dialogo.EliminarIndice;
        StateHasChanged();

        if (indice.EsUnico)
        {
            try
            {
                var tabla = nodo.Padre!.Padre!;
                var detalle = await _proveedor.ObtenerDetalleTablaAsync(Conexion, tabla.BaseDatos!, tabla.Tabla!);
                var usan = detalle.Referencias.Where(r => r.ColumnasDestino.SequenceEqual(indice.ColumnasClave, StringComparer.OrdinalIgnoreCase)).ToList();

                if (usan.Count > 0)
                {
                    _avisoEliminarIndice = $"Atención: {NarradorTablaService.Unir(usan.Select(r => $"la llave foránea {r.Nombre} de {r.TablaOrigen.NombreCorto()}"))} usa este índice único. {Conexion.Conexion.Motor.Nombre()} rechazará el borrado mientras exista.";
                    StateHasChanged();
                }
            }
            catch
            {
            }
        }
    }

    private Task AbrirEliminarCheckAsync(NodoArbolModelo nodo)
    {
        _nodoDialogo = nodo;
        _errorDialogo = null;
        _dialogo = Dialogo.EliminarCheck;
        return Task.CompletedTask;
    }

    private async Task EliminarIndiceAsync()
    {
        var nodo = _nodoDialogo!;
        var tabla = nodo.Padre!.Padre!;

        if (await EjecutarDialogoAsync(tabla.BaseDatos, _proveedor.ScriptEliminarIndice(tabla.Tabla!, nodo.Indice!)))
        {
            await TerminarDialogoTablaAsync(tabla, $"Índice {nodo.Indice!.Nombre} eliminado.");
        }
    }

    private async Task EliminarCheckAsync()
    {
        var nodo = _nodoDialogo!;
        var tabla = nodo.Padre!.Padre!;

        if (await EjecutarDialogoAsync(tabla.BaseDatos, _proveedor.ScriptEliminarCheck(tabla.Tabla!, nodo.Check!.Nombre)))
        {
            await TerminarDialogoTablaAsync(tabla, $"Restricción CHECK {nodo.Check!.Nombre} eliminada.");
        }
    }

    private void AgregarAccionesTabla(List<ElementoMenuModelo> elementos, NodoArbolModelo tabla, bool completo)
    {
        var nombre = tabla.Tabla!.NombreCompleto;
        var sufijo = completo ? "" : $" de {nombre}";

        elementos.Add(new() { Texto = completo ? "Describir" : $"Describir {nombre}", Accion = () => AlDescribir.InvokeAsync(tabla) });
        elementos.Add(new() { Texto = $"Ver dependencias{sufijo}", Accion = () => AlVerDependencias.InvokeAsync(tabla) });
        elementos.Add(new() { Texto = $"Seleccionar las primeras 100 filas{sufijo}", Accion = () => AbrirScriptAsync(tabla, TipoScript.SeleccionarPrimeras) });

        if (completo)
        {
            elementos.Add(new() { Texto = "Editar filas…", Accion = () => AlEditarFilas.InvokeAsync(tabla) });
        }

        if (!completo)
        {
            return;
        }

        elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(tabla.BaseDatos) });
        elementos.Add(ElementoMenuModelo.Separador());

        foreach (var tipo in new[] { TipoScript.Crear, TipoScript.Seleccionar, TipoScript.Insertar, TipoScript.Actualizar, TipoScript.Eliminar, TipoScript.EliminarTabla })
        {
            elementos.Add(new() { Texto = $"Generar script {tipo.Nombre()}", Accion = () => AbrirScriptAsync(tabla, tipo) });
        }

        if (_proveedor.Capacidades.PuedeDisenarTablas)
        {
            elementos.Add(ElementoMenuModelo.Separador());
            elementos.Add(new() { Texto = "Nueva llave foránea…", Accion = () => AbrirNuevaLlaveAsync(tabla) });
            elementos.Add(new() { Texto = "Nuevo índice…", Accion = () => AbrirNuevoIndiceAsync(tabla) });
            elementos.Add(new() { Texto = "Nueva restricción CHECK…", Accion = () => AbrirNuevoCheckAsync(tabla) });
            elementos.Add(new() { Texto = "Modificar tabla…", Accion = () => ModificarTablaAsync(tabla) });
        }

        elementos.Add(ElementoMenuModelo.Separador());
        elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(tabla) });
        elementos.Add(ElementoMenuModelo.Separador());
        elementos.Add(new() { Texto = "Eliminar tabla…", EsPeligro = true, Accion = () => AbrirEliminarTablaAsync(tabla) });
    }

    private void AgregarAccionesObjeto(List<ElementoMenuModelo> elementos, NodoArbolModelo nodo)
    {
        var objeto = nodo.Objeto!;

        elementos.Add(new() { Texto = "Describir", Accion = () => AlDescribir.InvokeAsync(nodo) });

        if (objeto.Tipo != TipoObjeto.Secuencia)
        {
            elementos.Add(new() { Texto = "Ver dependencias", Accion = () => AlVerDependencias.InvokeAsync(nodo) });
        }

        if (objeto.Tipo == TipoObjeto.Vista)
        {
            elementos.Add(new() { Texto = "Seleccionar las primeras 100 filas", Accion = () => SeleccionarVistaAsync(nodo) });
        }

        if (objeto.Tipo is TipoObjeto.Procedimiento or TipoObjeto.Funcion)
        {
            elementos.Add(new() { Texto = "Ejecutar…", Accion = () => AbrirDialogoObjetoAsync(nodo, Dialogo.EjecutarObjeto) });
        }

        elementos.Add(new() { Texto = "Generar script CREATE", Accion = () => AbrirScriptObjetoAsync(nodo) });

        if (objeto.Tipo == TipoObjeto.Disparador)
        {
            elementos.Add(new() { Texto = "Habilitar o deshabilitar…", Accion = () => AbrirDialogoObjetoAsync(nodo, Dialogo.HabilitarDisparador) });
        }

        if (objeto.Tipo == TipoObjeto.Secuencia)
        {
            elementos.Add(new() { Texto = "Reiniciar…", Accion = () => AbrirDialogoObjetoAsync(nodo, Dialogo.ReiniciarSecuencia) });
        }

        elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(nodo.BaseDatos) });
        elementos.Add(ElementoMenuModelo.Separador());
        elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(nodo) });
        elementos.Add(ElementoMenuModelo.Separador());
        elementos.Add(new() { Texto = $"Eliminar {objeto.Tipo.Singular()}…", EsPeligro = true, Accion = () => AbrirDialogoObjetoAsync(nodo, Dialogo.EliminarObjeto) });
    }

    private async Task SeleccionarVistaAsync(NodoArbolModelo nodo)
    {
        try
        {
            var detalle = await _proveedor.ObtenerDetalleObjetoAsync(Conexion, nodo.BaseDatos!, nodo.Objeto!);
            await AlAbrirScript.InvokeAsync(new ScriptAbiertoModelo(nodo.BaseDatos, _proveedor.ScriptSeleccionarPrimeras(detalle), true,
                $"Primeras 100 filas de {nodo.Objeto!.NombreCompleto}"));
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo consultar la vista. {ex.Message}");
        }
    }

    private async Task AbrirScriptObjetoAsync(NodoArbolModelo nodo)
    {
        try
        {
            var script = await _proveedor.GenerarScriptObjetoAsync(Conexion, nodo.BaseDatos!, nodo.Objeto!);
            await AlAbrirScript.InvokeAsync(new ScriptAbiertoModelo(nodo.BaseDatos, script, false,
                $"Script CREATE {nodo.Objeto!.Tipo.DeArticulo()} {nodo.Objeto.NombreCompleto}"));
        }
        catch (Exception ex)
        {
            await anunciador.AnunciarUrgenteAsync($"No se pudo generar el script. {ex.Message}");
        }
    }

    private async Task AbrirDialogoObjetoAsync(NodoArbolModelo nodo, Dialogo dialogo)
    {
        _nodoDialogo = nodo;
        _detalleObjeto = null;
        _errorDialogo = null;
        _valoresParametros = [];
        _valorSecuencia = "";
        _dialogo = dialogo;
        StateHasChanged();

        if (dialogo == Dialogo.EliminarObjeto)
        {
            _usanDialogo = null;
            _usanDialogo = await UsanAsync(nodo.BaseDatos!, DependenciasService.DesdeObjeto(nodo.Objeto!)) ?? [];
            StateHasChanged();
            return;
        }

        try
        {
            _detalleObjeto = await _proveedor.ObtenerDetalleObjetoAsync(Conexion, nodo.BaseDatos!, nodo.Objeto!);
        }
        catch (Exception ex)
        {
            _errorDialogo = $"No se pudo revisar {nodo.Objeto!.Tipo.ConArticulo()}. {ex.Message}";
            StateHasChanged();
            return;
        }

        _valorSecuencia = _detalleObjeto.Inicio ?? _detalleObjeto.Minimo ?? "1";
        _enfocarPendiente = dialogo switch
        {
            Dialogo.EjecutarObjeto when _detalleObjeto.Parametros.Any(p => p.Direccion != DireccionParametro.Salida)
                && !NarradorObjetoService.EsFuncionDisparador(_detalleObjeto) => "parametro-0",
            Dialogo.EjecutarObjeto => "boton-ejecutar-objeto",
            Dialogo.HabilitarDisparador => "boton-habilitar",
            _ => "valor-secuencia"
        };
        StateHasChanged();
    }

    private async Task EjecutarObjetoAsync()
    {
        var nodo = _nodoDialogo!;
        var script = _proveedor.ScriptLlamada(_detalleObjeto!, _valoresParametros);

        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await AlAbrirScript.InvokeAsync(new ScriptAbiertoModelo(nodo.BaseDatos, script, true, $"Llamada a {nodo.Objeto!.NombreCompleto}"));
    }

    private async Task EliminarObjetoAsync()
    {
        var nodo = _nodoDialogo!;
        var objeto = nodo.Objeto!;

        if (!await EjecutarDialogoAsync(nodo.BaseDatos, _proveedor.ScriptEliminarObjeto(objeto)))
        {
            return;
        }

        var destino = nodo.Padre!;

        while (destino.CargarHijos is null && destino.Padre is not null)
        {
            destino = destino.Padre;
        }

        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await RecargarAsync(destino);
        Activar(destino);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"{Mayuscula(objeto.Tipo.ConArticulo())} {objeto.NombreCompleto} se eliminó.");
    }

    private async Task CambiarDisparadorAsync()
    {
        var nodo = _nodoDialogo!;
        var habilitar = _detalleObjeto!.Habilitado == false;

        if (!await EjecutarDialogoAsync(nodo.BaseDatos, _proveedor.ScriptHabilitarDisparador(nodo.Objeto!, habilitar)))
        {
            return;
        }

        CerrarDialogo();
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"Disparador {nodo.Objeto!.NombreCompleto} {(habilitar ? "habilitado" : "deshabilitado")}.");
    }

    private async Task ReiniciarSecuenciaAsync()
    {
        if (!long.TryParse(_valorSecuencia.Trim(), out var valor))
        {
            _errorDialogo = "Escribe un número entero, por ejemplo 1000.";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var nodo = _nodoDialogo!;

        if (!await EjecutarDialogoAsync(nodo.BaseDatos, _proveedor.ScriptReiniciarSecuencia(nodo.Objeto!, valor)))
        {
            return;
        }

        CerrarDialogo();
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"Secuencia {nodo.Objeto!.NombreCompleto} reiniciada: el próximo valor será {valor}.");
    }

