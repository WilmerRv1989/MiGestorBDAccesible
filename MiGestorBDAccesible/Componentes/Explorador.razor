        _llaveReferencia.TablaDestino = destino.Tabla;
        _llaveReferencia.ColumnaDestino = destino.Columna;
        _llaveReferencia.TipoDestino = destino.TipoDatos;
    }

    private string? SqlNuevaLlave() =>
        _nodoDialogo?.Tabla is null || _llaveColumna.Length == 0 || _llaveReferencia.ColumnaDestino.Length == 0
            ? null
            : _proveedor.ScriptCrearLlaveForanea(new DefinicionLlaveForaneaModelo
            {
                TablaOrigen = _nodoDialogo.Tabla,
                ColumnaOrigen = _llaveColumna,
                Referencia = _llaveReferencia,
                ComprobarExistentes = _llaveComprobar
            });

    private async Task CrearLlaveAsync()
    {
        var columna = _detalleDialogo?.Columnas.FirstOrDefault(c => c.Nombre == _llaveColumna);

        if (columna is null)
        {
            _errorDialogo = "Elige la columna de esta tabla que va a apuntar.";
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var problemas = validador.ValidarReferencia(columna.Nombre, columna.TipoDatos, columna.PermiteNulos,
            columna.ValorPredeterminado is not null, _llaveReferencia, _proveedor.Capacidades.Terminos);

        if (problemas.Count > 0)
        {
            _errorDialogo = string.Join(" ", problemas.Select(p => p.Mensaje));
            await anunciador.AnunciarUrgenteAsync(_errorDialogo);
            return;
        }

        var tabla = _nodoDialogo!;

        if (!await EjecutarDialogoAsync(tabla.BaseDatos, SqlNuevaLlave()!))
        {
            return;
        }

        var destino = $"{_llaveReferencia.TablaDestino.NombreCorto()}.{_llaveReferencia.ColumnaDestino}";
        _dialogo = Dialogo.Ninguno;
        _nodoDialogo = null;
        await RecargarAsync(tabla);
        Activar(tabla);
        StateHasChanged();

        await Task.Delay(600);
        await anunciador.AnunciarAsync($"Llave foránea creada: {columna.Nombre} apunta a {destino}.");
    }

