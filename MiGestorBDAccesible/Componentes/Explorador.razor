@using MiGestorBDAccesible.Core.Definicion
@using MiGestorBDAccesible.Core.Descripcion
@using MiGestorBDAccesible.Core.Estructura
@using MiGestorBDAccesible.Modelos
@inject ProveedoresService proveedores
@inject NarradorTablaService narrador
@inject NarradorObjetoService narradorObjetos
@inject ComprobadorModificacionService comprobador
@inject AnunciadorService anunciador
@inject ValidadorTablaService validador
@inject IJSRuntime js

@if (_raiz is null)
{
    <p>Cargando el explorador…</p>
}
else
{
    <ul role="tree" aria-label="Explorador de objetos" class="arbol" @ref="_arbol" @onkeydown="TeclaAsync">
        @Nodo(_raiz, 1, 1)
    </ul>

    @if (_menuNodo is not null)
    {
        <MenuContextual Titulo="@($"Acciones de {_menuNodo.Texto}")"
                        Elementos="_elementosMenu"
                        AlCerrar="CerrarMenu" />
    }

    @if (_busquedaObjeto is not null && _buscarAbierto)
    {
        <DialogoBuscarObjeto Conexion="Conexion"
                             Estado="_busquedaObjeto"
                             Bases="_basesBusqueda"
                             EtiquetaBase="@(Conexion.Conexion.Motor == TipoMotor.Oracle ? "Esquema" : "Base de datos")"
                             DisparadoresBase="@_proveedor.Capacidades.TituloDisparadoresBase.Replace("Disparadores ", "")"
                             AlElegir="ElegirResultadoBusquedaAsync"
                             AlCancelar="CerrarBuscarObjetoAsync" />
    }
}

@switch (_dialogo)
{
    case Dialogo.NuevaBase:
        <DialogoAccion Titulo="Nueva base de datos" AlCancelar="CerrarDialogo">
            <div class="campo">
                <label for="nombre-base">Nombre de la base de datos</label>
                <input id="nombre-base" @bind="_nombreBase" @bind:event="oninput"
                           data-foco-inicial autocomplete="off" aria-describedby="sql-nueva-base" />
            </div>
            <p class="ayuda">Se ejecutará este SQL:</p>
            <pre id="sql-nueva-base"><code>@_proveedor.ScriptCrearBaseDatos(string.IsNullOrWhiteSpace(_nombreBase) ? "Nombre" : _nombreBase.Trim())</code></pre>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" disabled="@(_procesando || string.IsNullOrWhiteSpace(_nombreBase))" @onclick="CrearBaseAsync">Crear base de datos</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EliminarBase:
        <DialogoAccion Titulo="@($"Eliminar la base de datos {_nodoDialogo!.BaseDatos}")" EsAlerta="true" AlCancelar="CerrarDialogo">
            <p>Se borrará la base de datos @_nodoDialogo.BaseDatos con todas sus tablas y datos. No se puede deshacer. Antes se cierran las conexiones abiertas a esa base.</p>
            <div class="campo">
                <label for="confirmar-base">Para confirmar, escribe el nombre de la base de datos</label>
                <input id="confirmar-base" @bind="_confirmacion" @bind:event="oninput"
                           data-foco-inicial autocomplete="off" aria-describedby="sql-eliminar-base" />
            </div>
            <p class="ayuda">Se ejecutará este SQL:</p>
            <pre id="sql-eliminar-base"><code>@_proveedor.ScriptEliminarBaseDatos(_nodoDialogo.BaseDatos!)</code></pre>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="peligro" disabled="@(_procesando || _confirmacion?.Trim() != _nodoDialogo.BaseDatos)" @onclick="EliminarBaseAsync">Eliminar base de datos</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.NuevaLlave:
        <DialogoAccion Titulo="@($"Nueva llave foránea en {_nodoDialogo!.Tabla!.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleDialogo is null)
            {
                <p>Revisando la tabla…</p>
            }
            else
            {
                <div class="campo" data-ayuda="concepto:llave-foranea">
                    <label for="llave-columna">Columna de @_detalleDialogo.Tabla.NombreCorto() que va a apuntar</label>
                    <select id="llave-columna" data-foco-inicial value="@_llaveColumna" @onchange="e => _llaveColumna = e.Value?.ToString() ?? string.Empty">
                        <option value="">Elige una…</option>
                        @foreach (var columna in _detalleDialogo.Columnas)
                        {
                            <option value="@columna.Nombre">@columna.Nombre: @columna.TipoDatos</option>
                        }
                    </select>
                </div>
                <div class="campo" data-ayuda="concepto:llave-foranea">
                    <label for="llave-destino">Tabla y columna a la que apunta</label>
                    <select id="llave-destino" value="@(_llaveReferencia.ColumnaDestino.Length == 0 ? string.Empty : $"{_llaveReferencia.TablaDestino.NombreCompleto}.{_llaveReferencia.ColumnaDestino}")" @onchange="e => ElegirDestinoLlave(e.Value?.ToString())">
                        <option value="">Elige una…</option>
                        @foreach (var destino in _destinosDialogo)
                        {
                            <option value="@destino.Clave">@destino.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="campo" data-ayuda="concepto:reglas-referenciales">
                    <label for="llave-borrar">Al borrar una fila de la tabla destino (ON DELETE)</label>
                    <select id="llave-borrar" value="@_llaveReferencia.AlEliminar" @onchange="e => _llaveReferencia.AlEliminar = Enum.Parse<ReglaReferencial>(e.Value!.ToString()!)">
                        @foreach (var regla in _proveedor.Capacidades.ReglasAlEliminar)
                        {
                            <option value="@regla">@regla.Explicacion(true)</option>
                        }
                    </select>
                </div>
                @if (_proveedor.Capacidades.ReglasAlActualizar.Count > 0)
                {
                    <div class="campo" data-ayuda="concepto:reglas-referenciales">
                        <label for="llave-actualizar">Al cambiar la clave en la tabla destino (ON UPDATE)</label>
                        <select id="llave-actualizar" value="@_llaveReferencia.AlActualizar" @onchange="e => _llaveReferencia.AlActualizar = Enum.Parse<ReglaReferencial>(e.Value!.ToString()!)">
                            @foreach (var regla in _proveedor.Capacidades.ReglasAlActualizar)
                            {
                                <option value="@regla">@regla.Explicacion(false)</option>
                            }
                        </select>
                    </div>
                }
                <div class="campo casilla">
                    <input id="llave-comprobar" type="checkbox" checked="@_llaveComprobar" @onchange="e => _llaveComprobar = (bool)e.Value!" />
                    <label for="llave-comprobar">Comprobar las filas que ya existen (@_proveedor.Capacidades.Terminos.ComprobarExistentes)</label>
                </div>
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre><code>@(SqlNuevaLlave() ?? "Elige la columna y el destino para ver el SQL.")</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" disabled="@(_procesando || _detalleDialogo is null)" @onclick="CrearLlaveAsync">Crear llave foránea</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.Intermedia:
        <DialogoAccion Titulo="Asistente de tabla intermedia" AlCancelar="CerrarDialogo">
            <p>Una tabla intermedia relaciona dos tablas de muchos a muchos. Elige las dos tablas; después podrás agregar columnas extra, como una cantidad, en el formulario de Nueva tabla.</p>
            <div class="campo" data-ayuda="concepto:muchos-a-muchos">
                <label for="intermedia-a">Primera tabla</label>
                <select id="intermedia-a" data-foco-inicial value="@_intermediaA" @onchange="e => ElegirTablaIntermedia(true, e.Value?.ToString())">
                    <option value="">Elige una…</option>
                    @foreach (var destino in _destinosDialogo)
                    {
                        <option value="@destino.Clave">@destino.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo" data-ayuda="concepto:muchos-a-muchos">
                <label for="intermedia-b">Segunda tabla</label>
                <select id="intermedia-b" value="@_intermediaB" @onchange="e => ElegirTablaIntermedia(false, e.Value?.ToString())">
                    <option value="">Elige una…</option>
                    @foreach (var destino in _destinosDialogo)
                    {
                        <option value="@destino.Clave">@destino.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="intermedia-nombre">Nombre de la tabla intermedia</label>
                <input id="intermedia-nombre" value="@_intermediaNombre" autocomplete="off"
                       @oninput="e => { _intermediaNombre = e.Value?.ToString() ?? string.Empty; _intermediaNombreEditado = true; }"
                       aria-describedby="ayuda-intermedia" />
                <span id="ayuda-intermedia" class="ayuda">Se propone uniendo los nombres de las dos tablas; puedes cambiarlo.</span>
            </div>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" @onclick="PrepararIntermediaAsync">Preparar tabla intermedia</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EliminarTabla:
        <DialogoAccion Titulo="@($"Eliminar la tabla {_nodoDialogo!.Tabla!.NombreCompleto}")" EsAlerta="true" AlCancelar="CerrarDialogo">
            @if (_detalleDialogo is null)
            {
                <p>Revisando la tabla…</p>
            }
            else
            {
                <p>
                    Se borrará la tabla @_detalleDialogo.Tabla.NombreCompleto con sus @_detalleDialogo.Filas.ToString("N0") filas.
                    @(_proveedor.Capacidades.TienePapelera && !_purgar
                        ? $"Irá a la papelera de reciclaje de {Conexion.Conexion.Motor.Nombre()}: podrás recuperarla con FLASHBACK TABLE {_detalleDialogo.Tabla.Nombre} TO BEFORE DROP."
                        : "No se puede deshacer.")
                </p>
                @if (_usanDialogo is not null && DependenciasService.AvisoEliminar(_usanDialogo, "esta tabla") is { } avisoTabla)
                {
                    <p class="error">@avisoTabla</p>
                }
                @if (_detalleDialogo.Referencias.Count > 0)
                {
                    <p class="error">Atención: @NarradorTablaService.Unir(_detalleDialogo.Referencias.Select(r => $"{r.TablaOrigen.NombreCorto()} (llave {r.Nombre})")) apunta a esta tabla. @Conexion.Conexion.Motor.Nombre() rechazará el borrado mientras existan esas llaves foráneas.</p>
                }
                @if (_proveedor.TieneCambiosPendientes(Conexion))
                {
                    <p class="error">Una pestaña de consulta tiene cambios sin confirmar. Si tocan esta tabla, @Conexion.Conexion.Motor.Nombre() rechazará el borrado hasta que hagas COMMIT o ROLLBACK en esa pestaña.</p>
                }
                @if (_proveedor.Capacidades.TienePapelera)
                {
                    <div class="campo casilla">
                        <input id="purgar-tabla" type="checkbox" checked="@_purgar" @onchange="e => _purgar = (bool)e.Value!" />
                        <label for="purgar-tabla">Borrar definitivamente, sin pasar por la papelera (PURGE)</label>
                    </div>
                }
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre><code>@_proveedor.ScriptEliminarTabla(_detalleDialogo.Tabla, _purgar)</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="peligro" disabled="@(_procesando || _detalleDialogo is null)" @onclick="EliminarTablaAsync">Sí, eliminar la tabla</button>
                <button data-foco-inicial @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.NuevoIndice:
        <DialogoAccion Titulo="@($"Nuevo índice en {_nodoDialogo!.Tabla!.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleDialogo is null)
            {
                <p>Revisando la tabla…</p>
            }
            else
            {
                var disponibles = _detalleDialogo.Columnas.Where(c => !c.EsCalculada && !_defIndice.Columnas.Any(x => x.Nombre == c.Nombre) && !_defIndice.Incluidas.Contains(c.Nombre)).ToList();
                var repetido = IndiceRepetido();

                <div class="campo" data-ayuda="concepto:indice">
                    <label for="indice-nombre">Nombre del índice</label>
                    <input id="indice-nombre" autocomplete="off" value="@_defIndice.Nombre"
                           @oninput="e => { _defIndice.Nombre = e.Value?.ToString() ?? string.Empty; _nombreIndiceEditado = true; }" />
                </div>
                <fieldset data-ayuda="concepto:indice">
                    <legend>Columnas del índice (@_defIndice.Columnas.Count)</legend>
                    <p class="ayuda">El orden importa: un índice por Apellido y Nombre sirve para buscar por Apellido, o por Apellido y Nombre, pero no solo por Nombre.</p>
                    @if (_defIndice.Columnas.Count == 0)
                    {
                        <p>Todavía no elegiste columnas.</p>
                    }
                    else
                    {
                        <ul class="lista-columnas">
                            @for (var i = 0; i < _defIndice.Columnas.Count; i++)
                            {
                                var indice = i;
                                var columna = _defIndice.Columnas[i];
                                <li>
                                    <span>@(indice + 1). @columna.Nombre, @(columna.Descendente ? "descendente (DESC)" : "ascendente (ASC)")</span>
                                    <div class="acciones">
                                        <button id="@($"indice-col-{indice}-orden")" aria-label="@($"Cambiar {columna.Nombre} a {(columna.Descendente ? "ascendente" : "descendente")}")" @onclick="() => CambiarOrdenIndice(indice)">Cambiar orden</button>
                                        <button id="@($"indice-col-{indice}-subir")" aria-label="@($"Subir {columna.Nombre}")" disabled="@(indice == 0)" @onclick="() => MoverColumnaIndice(indice, -1)">Subir</button>
                                        <button id="@($"indice-col-{indice}-bajar")" aria-label="@($"Bajar {columna.Nombre}")" disabled="@(indice == _defIndice.Columnas.Count - 1)" @onclick="() => MoverColumnaIndice(indice, 1)">Bajar</button>
                                        <button aria-label="@($"Quitar {columna.Nombre} del índice")" @onclick="() => QuitarColumnaIndice(indice)">Quitar</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    <div class="campo">
                        <label for="indice-columna">Columna para agregar</label>
                        <select id="indice-columna" data-foco-inicial value="@_columnaIndiceElegida" @onchange="e => _columnaIndiceElegida = e.Value?.ToString() ?? string.Empty">
                            <option value="">Elige una…</option>
                            @foreach (var columna in disponibles)
                            {
                                <option value="@columna.Nombre">@columna.Nombre: @columna.TipoDatos</option>
                            }
                        </select>
                    </div>
                    <button id="indice-agregar" @onclick="AgregarColumnaIndiceAsync">Agregar al índice</button>
                </fieldset>
                <div class="campo casilla" data-ayuda="concepto:unique">
                    <input id="indice-unico" type="checkbox" checked="@_defIndice.EsUnico" @onchange="e => { _defIndice.EsUnico = (bool)e.Value!; _comprobacionesDialogo = []; }" />
                    <label for="indice-unico">Valor único, no se puede repetir (UNIQUE)</label>
                </div>
                @if (TieneOpcionesAvanzadas())
                {
                    var agrupado = _detalleDialogo.Indices.FirstOrDefault(i => i.EsAgrupado);
                    <fieldset data-ayuda="concepto:indice">
                        <legend>Opciones avanzadas</legend>
                        @if (_proveedor.Capacidades.Terminos.TieneIndicesAgrupados)
                        {
                            @if (agrupado is null)
                            {
                                <div class="campo casilla">
                                    <input id="indice-agrupado" type="checkbox" checked="@_defIndice.EsAgrupado" @onchange="e => _defIndice.EsAgrupado = (bool)e.Value!" />
                                    <label for="indice-agrupado">Agrupado (CLUSTERED): ordena la tabla por estas columnas; solo puede haber uno</label>
                                </div>
                            }
                            else
                            {
                                <p>La tabla ya tiene el índice agrupado @agrupado.Nombre, así que este será no agrupado (NONCLUSTERED).</p>
                            }
                        }
                        @if (_proveedor.Capacidades.IndiceIncluye)
                        {
                            <p class="ayuda">Columnas incluidas (INCLUDE): se guardan en el índice para que algunas consultas no tengan que leer la tabla, pero no sirven para buscar.</p>
                            @foreach (var incluida in _defIndice.Incluidas.ToList())
                            {
                                <div class="acciones">
                                    <span>Incluida: @incluida</span>
                                    <button aria-label="@($"Quitar {incluida} de las incluidas")" @onclick="() => _defIndice.Incluidas.Remove(incluida)">Quitar</button>
                                </div>
                            }
                            <div class="campo">
                                <label for="indice-incluida">Columna incluida para agregar, opcional</label>
                                <select id="indice-incluida" value="@_incluidaElegida" @onchange="e => _incluidaElegida = e.Value?.ToString() ?? string.Empty">
                                    <option value="">Ninguna</option>
                                    @foreach (var columna in disponibles)
                                    {
                                        <option value="@columna.Nombre">@columna.Nombre: @columna.TipoDatos</option>
                                    }
                                </select>
                            </div>
                            <button @onclick="AgregarIncluidaAsync">Incluir columna</button>
                        }
                        @if (_proveedor.Capacidades.IndiceFiltrado)
                        {
                            <div class="campo">
                                <label for="indice-filtro">Solo algunas filas (WHERE), opcional</label>
                                <input id="indice-filtro" autocomplete="off" value="@_defIndice.Filtro" aria-describedby="ayuda-filtro"
                                       @oninput="e => { _defIndice.Filtro = e.Value?.ToString(); _comprobacionesDialogo = []; }" />
                                <span id="ayuda-filtro" class="ayuda">Por ejemplo, Activo = 1. El índice solo tendrá las filas que cumplan la condición.</span>
                            </div>
                        }
                        @if (_proveedor.Capacidades.MetodosIndice.Count > 0)
                        {
                            <div class="campo">
                                <label for="indice-metodo">Método (USING)</label>
                                <select id="indice-metodo" value="@(_defIndice.Metodo ?? "btree")" @onchange="e => _defIndice.Metodo = e.Value?.ToString()">
                                    @foreach (var (nombre, explicacion) in _proveedor.Capacidades.MetodosIndice)
                                    {
                                        <option value="@nombre">@nombre: @explicacion</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_proveedor.Capacidades.IndiceConcurrente)
                        {
                            <div class="campo casilla">
                                <input id="indice-concurrente" type="checkbox" checked="@_defIndice.Concurrente" @onchange="e => _defIndice.Concurrente = (bool)e.Value!" />
                                <label for="indice-concurrente">Sin bloquear la tabla mientras se crea (CONCURRENTLY): tarda más, pero se puede seguir escribiendo en ella</label>
                            </div>
                        }
                    </fieldset>
                }
                @if (repetido is not null)
                {
                    <p class="error">Ya existe el índice @repetido.Nombre con las mismas columnas en el mismo orden; otro igual no acelerará nada.</p>
                }
                <p class="ayuda">Un índice acelera las búsquedas por estas columnas, pero hace algo más lentos los INSERT y UPDATE.</p>
                @ListaComprobaciones()
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre><code>@(_defIndice.Columnas.Count == 0 ? "Agrega al menos una columna para ver el SQL." : _proveedor.ScriptCrearIndice(DefinicionIndiceFinal()))</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" disabled="@(_procesando || _detalleDialogo is null)" @onclick="CrearIndiceAsync">Crear índice</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.NuevoCheck:
        <DialogoAccion Titulo="@($"Nueva restricción CHECK en {_nodoDialogo!.Tabla!.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleDialogo is null)
            {
                <p>Revisando la tabla…</p>
            }
            else
            {
                <div class="campo" data-ayuda="concepto:check">
                    <label for="check-nombre">Nombre de la restricción</label>
                    <input id="check-nombre" autocomplete="off" value="@_defCheck.Nombre"
                           @oninput="e => { _defCheck.Nombre = e.Value?.ToString() ?? string.Empty; _nombreCheckEditado = true; }" />
                </div>
                <fieldset data-ayuda="concepto:check">
                    <legend>Cómo escribir la condición</legend>
                    <div class="campo casilla">
                        <input id="check-modo-asistente" type="radio" name="check-modo" checked="@_checkConAsistente" @onchange="() => { _checkConAsistente = true; _comprobacionesDialogo = []; }" />
                        <label for="check-modo-asistente">Con el asistente</label>
                    </div>
                    <div class="campo casilla">
                        <input id="check-modo-manual" type="radio" name="check-modo" checked="@(!_checkConAsistente)" @onchange="() => { _checkConAsistente = false; _comprobacionesDialogo = []; }" />
                        <label for="check-modo-manual">A mano</label>
                    </div>
                </fieldset>
                @if (_checkConAsistente)
                {
                    <div class="campo" data-ayuda="concepto:check">
                        <label for="check-columna">Columna</label>
                        <select id="check-columna" data-foco-inicial value="@_checkColumna" @onchange="e => { _checkColumna = e.Value?.ToString() ?? string.Empty; ActualizarNombreCheck(); _comprobacionesDialogo = []; }">
                            <option value="">Elige una…</option>
                            @foreach (var columna in _detalleDialogo.Columnas.Where(c => !c.EsCalculada))
                            {
                                <option value="@columna.Nombre">@columna.Nombre: @columna.TipoDatos</option>
                            }
                        </select>
                    </div>
                    <div class="campo">
                        <label for="check-comparacion">Comparación</label>
                        <select id="check-comparacion" value="@_checkComparacion" @onchange="e => { _checkComparacion = Enum.Parse<ComparacionCheck>(e.Value!.ToString()!); _comprobacionesDialogo = []; }">
                            @foreach (var comparacion in Enum.GetValues<ComparacionCheck>())
                            {
                                <option value="@comparacion">@comparacion.Texto()</option>
                            }
                        </select>
                    </div>
                    @if (_checkComparacion.UsaValor())
                    {
                        <div class="campo">
                            <label for="check-valor">@(_checkComparacion switch { ComparacionCheck.Entre => "Desde", ComparacionCheck.EnLista => "Valores separados por comas", _ => "Valor" })</label>
                            <input id="check-valor" autocomplete="off" value="@_checkValor" aria-describedby="ayuda-check-valor"
                                   @oninput="e => { _checkValor = e.Value?.ToString() ?? string.Empty; _comprobacionesDialogo = []; }" />
                            <span id="ayuda-check-valor" class="ayuda">Escribe los textos y las fechas sin comillas: la app las agrega.</span>
                        </div>
                        @if (_checkComparacion == ComparacionCheck.Entre)
                        {
                            <div class="campo">
                                <label for="check-valor2">Hasta</label>
                                <input id="check-valor2" autocomplete="off" value="@_checkValor2" @oninput="e => { _checkValor2 = e.Value?.ToString() ?? string.Empty; _comprobacionesDialogo = []; }" />
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="campo" data-ayuda="concepto:check">
                        <label for="check-condicion">Condición</label>
                        <textarea id="check-condicion" rows="3" spellcheck="false" aria-describedby="ayuda-check-condicion"
                                  value="@_checkManual" @oninput="e => { _checkManual = e.Value?.ToString() ?? string.Empty; _comprobacionesDialogo = []; }"></textarea>
                        <span id="ayuda-check-condicion" class="ayuda">@EjemplosCheck()</span>
                    </div>
                }
                <p class="ayuda">Si la columna admite NULL, las filas con NULL siempre pasan: un CHECK solo rechaza lo que da falso.</p>
                <div class="campo casilla">
                    <input id="check-comprobar" type="checkbox" checked="@_defCheck.ComprobarExistentes" @onchange="e => { _defCheck.ComprobarExistentes = (bool)e.Value!; _comprobacionesDialogo = []; }" />
                    <label for="check-comprobar">Comprobar las filas que ya existen (@_proveedor.Capacidades.Terminos.ComprobarExistentes)</label>
                </div>
                @ListaComprobaciones()
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre><code>@(CondicionCheck() is null ? "Completa la condición para ver el SQL." : _proveedor.ScriptCrearCheck(DefinicionCheckFinal()))</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" disabled="@(_procesando || _detalleDialogo is null)" @onclick="CrearCheckAsync">Crear restricción</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EliminarIndice:
        <DialogoAccion Titulo="@($"Eliminar el índice {_nodoDialogo!.Indice!.Nombre}")" EsAlerta="true" AlCancelar="CerrarDialogo">
            <p>Se borrará el índice @_nodoDialogo.Indice.Nombre de @_nodoDialogo.Padre!.Padre!.Tabla!.NombreCompleto. Los datos no se tocan; las búsquedas por esas columnas pueden volverse más lentas.</p>
            @if (_avisoEliminarIndice is not null)
            {
                <p class="error">@_avisoEliminarIndice</p>
            }
            <p class="ayuda">Se ejecutará este SQL:</p>
            <pre><code>@_proveedor.ScriptEliminarIndice(_nodoDialogo.Padre.Padre.Tabla, _nodoDialogo.Indice)</code></pre>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="peligro" disabled="@_procesando" @onclick="EliminarIndiceAsync">Sí, eliminar el índice</button>
                <button data-foco-inicial @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EliminarCheck:
        <DialogoAccion Titulo="@($"Eliminar la restricción CHECK {_nodoDialogo!.Check!.Nombre}")" EsAlerta="true" AlCancelar="CerrarDialogo">
            <p>Se borrará la restricción @_nodoDialogo.Check.Nombre (@NarradorTablaService.QuitarParentesisExternos(_nodoDialogo.Check.Definicion)). Desde entonces se aceptarán valores que antes se rechazaban.</p>
            <p class="ayuda">Se ejecutará este SQL:</p>
            <pre><code>@_proveedor.ScriptEliminarCheck(_nodoDialogo.Padre!.Padre!.Tabla!, _nodoDialogo.Check.Nombre)</code></pre>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="peligro" disabled="@_procesando" @onclick="EliminarCheckAsync">Sí, eliminar la restricción</button>
                <button data-foco-inicial @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EliminarObjeto:
        <DialogoAccion Titulo="@($"Eliminar {_nodoDialogo!.Objeto!.Tipo.ConArticulo()} {_nodoDialogo.Objeto.NombreCompleto}")" EsAlerta="true" AlCancelar="CerrarDialogo">
            <p>
                Se borrará @_nodoDialogo.Objeto.Tipo.ConArticulo() @_nodoDialogo.Objeto.NombreCompleto@(_nodoDialogo.Objeto.Tipo == TipoObjeto.Paquete ? " con su cuerpo (PACKAGE BODY)" : "").
                No se puede deshacer.
            </p>
            @if (_usanDialogo is null)
            {
                <p>Revisando qué objetos lo usan…</p>
            }
            else if (DependenciasService.AvisoEliminar(_usanDialogo, EsteObjeto(_nodoDialogo.Objeto.Tipo)) is { } avisoObjeto)
            {
                <p class="error">@avisoObjeto O @Conexion.Conexion.Motor.Nombre() rechazará el borrado.</p>
            }
            else
            {
                <p>Según el catálogo, ningún objeto usa @_nodoDialogo.Objeto.NombreCompleto.</p>
            }
            @if (_proveedor.TieneCambiosPendientes(Conexion))
            {
                <p class="error">Una pestaña de consulta tiene cambios sin confirmar. Si usan @_nodoDialogo.Objeto.NombreCompleto, @Conexion.Conexion.Motor.Nombre() rechazará el borrado hasta que hagas COMMIT o ROLLBACK en esa pestaña.</p>
            }
            <p class="ayuda">Se ejecutará este SQL:</p>
            <pre><code>@_proveedor.ScriptEliminarObjeto(_nodoDialogo.Objeto)</code></pre>
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="peligro" disabled="@_procesando" @onclick="EliminarObjetoAsync">Sí, eliminar @_nodoDialogo.Objeto.Tipo.ConArticulo()</button>
                <button data-foco-inicial @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.EjecutarObjeto:
        <DialogoAccion Titulo="@($"Ejecutar {_nodoDialogo!.Objeto!.Tipo.ConArticulo()} {_nodoDialogo.Objeto.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleObjeto is null)
            {
                <p>Revisando los parámetros…</p>
            }
            else if (NarradorObjetoService.EsFuncionDisparador(_detalleObjeto))
            {
                <p>Esta función devuelve @_detalleObjeto.Retorno: la ejecuta un disparador cuando ocurre su evento, no se puede llamar directamente.</p>
            }
            else
            {
                var entradas = _detalleObjeto.Parametros.Where(p => p.Direccion != DireccionParametro.Salida).ToList();
                var salidas = _detalleObjeto.Parametros.Where(p => p.Direccion != DireccionParametro.Entrada).ToList();

                @if (entradas.Count == 0)
                {
                    <p>No necesita valores de entrada.</p>
                }
                else
                {
                    <p class="ayuda" id="ayuda-parametros">Deja un campo vacío para enviar NULL. Escribe los textos y las fechas sin comillas, por ejemplo 2026-01-31: la app agrega las comillas.</p>
                    @for (var i = 0; i < entradas.Count; i++)
                    {
                        var parametro = entradas[i];
                        <div class="campo">
                            <label for="@($"parametro-{i}")">@parametro.Nombre (@parametro.TipoDatos@(parametro.Direccion == DireccionParametro.EntradaSalida ? ", de entrada y salida" : ""))</label>
                            <input id="@($"parametro-{i}")" autocomplete="off" aria-describedby="ayuda-parametros"
                                   value="@(_valoresParametros.GetValueOrDefault(parametro.Nombre))"
                                   @oninput="e => _valoresParametros[parametro.Nombre] = e.Value?.ToString()" />
                        </div>
                    }
                }

                @if (salidas.Count > 0)
                {
                    <p>@(Conexion.Conexion.Motor == TipoMotor.PostgreSql
                        ? $"Los valores de salida ({NarradorTablaService.Unir(salidas.Select(s => s.Nombre))}) aparecerán en los resultados."
                        : $"Los valores de salida ({NarradorTablaService.Unir(salidas.Select(s => s.Nombre))}) aparecerán en el panel de mensajes.")</p>
                }

                <p class="ayuda">Se escribirá y ejecutará este SQL en el editor:</p>
                <pre><code>@_proveedor.ScriptLlamada(_detalleObjeto, _valoresParametros)</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button id="boton-ejecutar-objeto" class="principal" disabled="@(_detalleObjeto is null || NarradorObjetoService.EsFuncionDisparador(_detalleObjeto))" @onclick="EjecutarObjetoAsync">Ejecutar</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.HabilitarDisparador:
        <DialogoAccion Titulo="@($"Habilitar o deshabilitar el disparador {_nodoDialogo!.Objeto!.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleObjeto is null)
            {
                <p>Revisando el disparador…</p>
            }
            else
            {
                var habilitado = _detalleObjeto.Habilitado != false;
                <p>El disparador está @(habilitado ? "habilitado: se ejecuta en cada evento" : "deshabilitado: no se ejecuta hasta que lo habilites").</p>
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre><code>@_proveedor.ScriptHabilitarDisparador(_nodoDialogo.Objeto, !habilitado)</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button id="boton-habilitar" class="principal" disabled="@(_procesando || _detalleObjeto is null)" @onclick="CambiarDisparadorAsync">@(_detalleObjeto?.Habilitado == false ? "Habilitar disparador" : "Deshabilitar disparador")</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;

    case Dialogo.ReiniciarSecuencia:
        <DialogoAccion Titulo="@($"Reiniciar la secuencia {_nodoDialogo!.Objeto!.NombreCompleto}")" AlCancelar="CerrarDialogo">
            @if (_detalleObjeto is null)
            {
                <p>Revisando la secuencia…</p>
            }
            else
            {
                <p>@(_detalleObjeto.ValorActual is { } actual ? $"El último valor entregado es {actual}." : "La secuencia todavía no informa un valor actual.") El próximo valor que entregue será el que escribas aquí.</p>
                <div class="campo">
                    <label for="valor-secuencia">Valor con el que vuelve a empezar</label>
                    <input id="valor-secuencia" inputmode="numeric" autocomplete="off" aria-describedby="sql-reiniciar"
                           value="@_valorSecuencia" @oninput="e => _valorSecuencia = e.Value?.ToString() ?? string.Empty" />
                </div>
                <p class="ayuda">Se ejecutará este SQL:</p>
                <pre id="sql-reiniciar"><code>@(long.TryParse(_valorSecuencia.Trim(), out var valor) ? _proveedor.ScriptReiniciarSecuencia(_nodoDialogo.Objeto, valor) : "Escribe un número entero para ver el SQL.")</code></pre>
            }
            <ErrorDialogo Mensaje="@_errorDialogo" />
            <div class="acciones">
                <button class="principal" disabled="@(_procesando || _detalleObjeto is null)" @onclick="ReiniciarSecuenciaAsync">Reiniciar secuencia</button>
                <button @onclick="CerrarDialogo">Cancelar</button>
            </div>
        </DialogoAccion>
        break;
}

@code {
    [Parameter, EditorRequired] public ConexionActiva Conexion { get; set; } = default!;
    [Parameter] public EventCallback<NodoArbolModelo> AlDescribir { get; set; }
    [Parameter] public EventCallback<string?> AlNuevaConsulta { get; set; }
    [Parameter] public EventCallback<ScriptAbiertoModelo> AlAbrirScript { get; set; }
    [Parameter] public EventCallback<SolicitudTablaModelo> AlNuevaTabla { get; set; }
    [Parameter] public EventCallback<NodoArbolModelo> AlEditarFilas { get; set; }
    [Parameter] public EventCallback<string> AlDescribirModelo { get; set; }
    [Parameter] public EventCallback<string> AlCaminoJoin { get; set; }
    [Parameter] public EventCallback<NodoArbolModelo> AlVerDependencias { get; set; }

    private enum Dialogo { Ninguno, NuevaBase, EliminarBase, EliminarTabla, NuevaLlave, Intermedia, EliminarObjeto, EjecutarObjeto, HabilitarDisparador, ReiniciarSecuencia, NuevoIndice, NuevoCheck, EliminarIndice, EliminarCheck }

    private IProveedorBaseDatos _proveedor = default!;
    private NodoArbolModelo? _raiz;
    private NodoArbolModelo? _carpetaBases;
    private NodoArbolModelo? _menuNodo;
    private List<ElementoMenuModelo> _elementosMenu = [];
    private Dialogo _dialogo = Dialogo.Ninguno;
    private NodoArbolModelo? _nodoDialogo;
    private DetalleTablaModelo? _detalleDialogo;
    private List<DependenciaModelo>? _usanDialogo;
    private DetalleObjetoModelo? _detalleObjeto;
    private Dictionary<string, string?> _valoresParametros = [];
    private string _valorSecuencia = "";
    private DefinicionIndiceModelo _defIndice = new();
    private bool _nombreIndiceEditado;
    private string _columnaIndiceElegida = "";
    private string _incluidaElegida = "";
    private DefinicionCheckModelo _defCheck = new();
    private bool _nombreCheckEditado;
    private bool _checkConAsistente = true;
    private string _checkColumna = "";
    private ComparacionCheck _checkComparacion = ComparacionCheck.MayorOIgual;
    private string _checkValor = "";
    private string _checkValor2 = "";
    private string _checkManual = "";
    private string? _avisoEliminarIndice;
    private List<ComprobacionModelo> _comprobacionesDialogo = [];
    private readonly Dictionary<string, DefinicionIndiceModelo> _borradoresIndice = [];
    private readonly Dictionary<string, (DefinicionCheckModelo, bool, string, ComparacionCheck, string, string, string)> _borradoresCheck = [];
    private string? _nombreBase;
    private string? _confirmacion;
    private string? _errorDialogo;
    private bool _procesando;
    private bool _purgar;
    private List<DestinoLlaveModelo> _destinosDialogo = [];
    private string _llaveColumna = "";
    private ReferenciaModelo _llaveReferencia = new();
    private bool _llaveComprobar = true;
    private string _intermediaA = "";
    private string _intermediaB = "";
    private string _intermediaNombre = "";
    private bool _intermediaNombreEditado;
    private NodoArbolModelo? _activo;
    private EstadoBusquedaObjetoModelo? _busquedaObjeto;
    private List<string> _basesBusqueda = [];
    private bool _buscarAbierto;
    private string? _enfocarPendiente;
    private bool _arbolPreparado;
    private ElementReference _arbol;

    private RenderFragment Nodo(NodoArbolModelo nodo, int posicion, int total) => __builder =>
    {
        var activo = nodo == _activo;

        <li id="@nodo.Id"
            role="treeitem"
            aria-labelledby="@($"{nodo.Id}-texto")"
            aria-level="@nodo.Nivel"
            aria-posinset="@posicion"
            aria-setsize="@total"
            aria-expanded="@(nodo.PuedeExpandirse ? (nodo.Expandido ? "true" : "false") : null)"
            aria-selected="@(activo ? "true" : "false")"
            aria-busy="@(nodo.Cargando ? "true" : null)"
            tabindex="@(activo ? 0 : -1)"
            class="@(activo ? "activo" : null)"
            data-ayuda="@(nodo.TemasAyuda.Count > 0 ? string.Join("|", nodo.TemasAyuda) : null)"
            data-base="@nodo.BaseDatos"
            @onfocus="() => _activo = nodo"
            @onclick="() => ClicAsync(nodo)"
            @onclick:stopPropagation="true"
            @oncontextmenu="() => AbrirMenuAsync(nodo)"
            @oncontextmenu:preventDefault="true"
            @oncontextmenu:stopPropagation="true">
            <span id="@($"{nodo.Id}-texto")" class="texto-nodo">@nodo.Texto@(nodo.Cargando ? " (cargando…)" : "")</span>

            @if (nodo.Expandido && nodo.Hijos is { Count: > 0 } hijos)
            {
                <ul role="group">
                    @for (var i = 0; i < hijos.Count; i++)
                    {
                        @Nodo(hijos[i], i + 1, hijos.Count)
                    }
                </ul>
            }
        </li>
    };

    protected override async Task OnInitializedAsync()
    {
        _proveedor = proveedores.Obtener(Conexion.Conexion.Motor);

        var raiz = new NodoArbolModelo
        {
            Texto = $"{Conexion.Conexion.Nombre}, {Conexion.Servidor.Producto}",
            Tipo = TipoNodo.Servidor,
            Expandido = true
        };

        var carpetaBases = new NodoArbolModelo
        {
            Texto = _proveedor.Capacidades.ContenedoresTitulo,
            Tipo = TipoNodo.Carpeta,
            Padre = raiz,
            CargarHijos = CargarBasesDatosAsync
        };

        raiz.Hijos = [carpetaBases];
        _carpetaBases = carpetaBases;

        await ExpandirAsync(carpetaBases);

        _raiz = raiz;
        var preferida = Conexion.Conexion.BaseDatosInicial ?? _proveedor.EsquemaPredeterminado(Conexion);
        var bases = carpetaBases.Hijos?.Where(n => n.Tipo == TipoNodo.BaseDatos).ToList() ?? [];
        _activo = bases.FirstOrDefault(n => string.Equals(n.BaseDatos, preferida, StringComparison.OrdinalIgnoreCase))
            ?? bases.FirstOrDefault()
            ?? carpetaBases;
        _enfocarPendiente = _activo.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_raiz is not null && !_arbolPreparado && !string.IsNullOrEmpty(_arbol.Id))
        {
            _arbolPreparado = true;
            await js.InvokeVoidAsync("miGestor.prepararArbol", _arbol);
        }

        if (_enfocarPendiente is not null)
        {
            var id = _enfocarPendiente;
            _enfocarPendiente = null;
            await js.InvokeVoidAsync("miGestor.enfocar", id);
        }
    }

    private async Task TeclaAsync(KeyboardEventArgs e)
    {
        if (_activo is null || _raiz is null)
        {
            return;
        }

        var visibles = Visibles();
        var indice = visibles.IndexOf(_activo);

        switch (e.Key)
        {
            case "ArrowDown":
                Activar(visibles[Math.Min(indice + 1, visibles.Count - 1)]);
                break;

            case "ArrowUp":
                Activar(visibles[Math.Max(indice - 1, 0)]);
                break;

            case "Home":
                Activar(visibles[0]);
                break;

            case "End":
                Activar(visibles[^1]);
                break;

            case "ArrowRight":
                if (_activo.PuedeExpandirse && !_activo.Expandido)
                {
                    await ExpandirAsync(_activo);
                }
                else if (_activo.Expandido && _activo.Hijos is { Count: > 0 } hijos)
                {
                    Activar(hijos[0]);
                }
                break;

            case "ArrowLeft":
                if (_activo.Expandido && _activo.Padre is not null)
                {
                    _activo.Expandido = false;
                }
                else if (_activo.Padre is not null)
                {
                    Activar(_activo.Padre);
                }
                break;

            case "Enter":
                await AccionPrincipalAsync(_activo);
                break;

            case "ContextMenu":
                await AbrirMenuAsync(_activo);
                break;

            case "F10" when e.ShiftKey:
                await AbrirMenuAsync(_activo);
                break;
        }
    }

    private async Task AbrirMenuAsync(NodoArbolModelo nodo)
    {
        _activo = nodo;
        var elementos = ElementosMenu(nodo);

        if (elementos.Count == 0)
        {
            await anunciador.AnunciarAsync("No hay acciones para este elemento.");
            return;
        }

        _elementosMenu = elementos.Select(e => e.Accion is not { } accion
            ? e
            : new ElementoMenuModelo
            {
                Texto = e.Texto,
                EsPeligro = e.EsPeligro,
                Accion = () => InvokeAsync(async () =>
                {
                    await accion();
                    StateHasChanged();
                })
            }).ToList();
        _menuNodo = nodo;
    }

    private void CerrarMenu()
    {
        var nodo = _menuNodo;
        _menuNodo = null;

        if (nodo is not null)
        {
            Activar(nodo);
        }
    }

    private List<ElementoMenuModelo> ElementosMenu(NodoArbolModelo nodo)
    {
        var elementos = new List<ElementoMenuModelo>();

        switch (nodo.Tipo)
        {
            case TipoNodo.Servidor:
                elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(null) });

                if (_proveedor.Capacidades.PuedeCrearContenedores)
                {
                    elementos.Add(new() { Texto = "Nueva base de datos…", Accion = AbrirNuevaBaseAsync });
                }

                elementos.Add(ElementoMenuModelo.Separador());
                elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(_carpetaBases!) });
                break;

            case TipoNodo.BaseDatos:
                elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(nodo.BaseDatos) });

                if (!nodo.EsSistema && nodo.CargarHijos is not null && _proveedor.Capacidades.PuedeDisenarTablas)
                {
                    elementos.Add(new() { Texto = "Nueva tabla…", Accion = () => AlNuevaTabla.InvokeAsync(new SolicitudTablaModelo(nodo.BaseDatos!)) });
                    elementos.Add(new() { Texto = "Asistente de tabla intermedia…", Accion = () => AbrirIntermediaAsync(nodo) });
                }

                if (!nodo.EsSistema && nodo.CargarHijos is not null)
                {
                    elementos.Add(ElementoMenuModelo.Separador());
                    elementos.Add(new() { Texto = "Describir el modelo", Accion = () => AlDescribirModelo.InvokeAsync(nodo.BaseDatos!) });
                    elementos.Add(new() { Texto = "Camino de JOIN…", Accion = () => AlCaminoJoin.InvokeAsync(nodo.BaseDatos!) });
                    elementos.Add(new() { Texto = "Buscar objeto…", Accion = () => AbrirBuscarObjetoAsync(nodo.BaseDatos) });
                }

                elementos.Add(ElementoMenuModelo.Separador());
                elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(nodo) });

                if (!nodo.EsSistema && _proveedor.Capacidades.PuedeCrearContenedores)
                {
                    elementos.Add(ElementoMenuModelo.Separador());
                    elementos.Add(new() { Texto = "Eliminar base de datos…", EsPeligro = true, Accion = () => AbrirEliminarBaseAsync(nodo) });
                }
                break;

            case TipoNodo.Tabla:
                AgregarAccionesTabla(elementos, nodo, true);
                break;

            case TipoNodo.Objeto:
                AgregarAccionesObjeto(elementos, nodo);
                break;

            case TipoNodo.Carpeta when nodo == _carpetaBases:
                if (_proveedor.Capacidades.PuedeCrearContenedores)
                {
                    elementos.Add(new() { Texto = "Nueva base de datos…", Accion = AbrirNuevaBaseAsync });
                }

                elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(nodo) });
                break;

            default:
                var tabla = Ancestro(nodo, TipoNodo.Tabla);

                if (tabla is not null)
                {
                    if (nodo.Indice is not null)
                    {
                        elementos.Add(new() { Texto = "Eliminar índice…", EsPeligro = true, Accion = () => AbrirEliminarIndiceAsync(nodo) });
                        elementos.Add(ElementoMenuModelo.Separador());
                    }
                    else if (nodo.Check is not null)
                    {
                        elementos.Add(new() { Texto = "Eliminar restricción CHECK…", EsPeligro = true, Accion = () => AbrirEliminarCheckAsync(nodo) });
                        elementos.Add(ElementoMenuModelo.Separador());
                    }

                    AgregarAccionesTabla(elementos, tabla, false);
                }
                else if (nodo.BaseDatos is not null && nodo.TipoCarpeta is not null)
                {
                    elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(nodo.BaseDatos) });
                    elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(nodo) });
                }
                else if (nodo.BaseDatos is not null && nodo.Tipo == TipoNodo.Carpeta)
                {
                    elementos.Add(new() { Texto = "Nueva consulta", Accion = () => AlNuevaConsulta.InvokeAsync(nodo.BaseDatos) });

                    if (nodo.Padre is { EsSistema: false } && nodo.TipoCarpeta is null && _proveedor.Capacidades.PuedeDisenarTablas)
                    {
                        elementos.Add(new() { Texto = "Nueva tabla…", Accion = () => AlNuevaTabla.InvokeAsync(new SolicitudTablaModelo(nodo.BaseDatos!)) });
                        elementos.Add(new() { Texto = "Asistente de tabla intermedia…", Accion = () => AbrirIntermediaAsync(nodo) });
                    }

                    elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(nodo) });
                }
                else if (nodo.Tipo == TipoNodo.Carpeta)
                {
                    elementos.Add(new() { Texto = "Actualizar", Accion = () => ActualizarAsync(_carpetaBases!) });
                }
                break;
        }

        return elementos;
    }

    private RenderFragment ListaComprobaciones() => __builder =>
    {
        @if (_comprobacionesDialogo.Count > 0)
        {
            <h3 id="titulo-comprobaciones-dialogo" tabindex="-1">Comprobaciones (@_comprobacionesDialogo.Count)</h3>
