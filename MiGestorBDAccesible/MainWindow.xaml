<Window x:Class="MiGestorBDAccesible.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:componentes="clr-namespace:MiGestorBDAccesible.Componentes"
        Title="Mi Gestor BD Accesible" Height="768" Width="1200" WindowState="Maximized">
    <Grid>
        <blazor:BlazorWebView x:Name="vistaBlazor" HostPage="wwwroot\index.html" Services="{DynamicResource servicios}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type componentes:Principal}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
